# Copy to .env for local builds. Only PUBLIC_* values; never a secret here.
# production = indexable live site; anything else builds a noindex preview.
PUBLIC_ENV=preview
# Legacy account pages (delete-account.html, reset-password.html). Public by design.
# Supabase project URL today; https://api.palmsays.com once WEB-SRV-002 is live.
PUBLIC_SUPABASE_URL=
# The publishable (anon) key only. The build refuses sb_secret_ / service_role keys.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Web reading (src/lib/reading/config.ts). Preview builds only: mock | live | off (production follows
# site.webReadingEnabled). ?reading=mock in the URL does the same on a preview.
PUBLIC_READING_MODE=
# Preview builds only: another https proxy in front of Supabase (never *.supabase.co). Production = site.apiUrl.
PUBLIC_API_URL=
# Cloudflare Turnstile SITE key of the palmsays.com widget (public). The secret lives only in Supabase (TURNSTILE_SECRET).
PUBLIC_TURNSTILE_SITE_KEY=
# "Continue with Google" on /account/ and /reading/ (WEB-DEC-045): the app's Google WEB client ID, public by design
# (same one Supabase's Google provider trusts). Empty = the Google button is hidden; the email code still works.
PUBLIC_GOOGLE_WEB_CLIENT_ID=864260847321-9mpkdijstu971k5p8jeg6p114u1vo442.apps.googleusercontent.com
