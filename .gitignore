# build output
dist/
dist-*/
.astro/
.wrangler/

# dependencies
node_modules/
research-tools/node_modules/

# screenshots (evidence paths go in PROJECT_MASTER.md)
qa/shots/
.shots/

# env and logs
.env
.env.*
!.env.example
.dev.vars
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# local-only
.claude/settings.local.json
# research screenshots (160 MB, reproducible with research-tools/shot.mjs; kept on the laptop)
research/screens/
# raw AI asset samples (large PNGs; optimised copies go to public/ when approved)
design-v4/samples/
# promo video outputs + render temp (reproducible with marketing/promo-video/build.mjs; kept on the laptop)
marketing/promo-video/*.mp4
marketing/promo-video/.work/

# QA screenshots, videos, PDFs and audit dumps (~420 MB, reproducible; kept on the laptop).
# Only the small .md reports in qa/ stay tracked. Lighthouse reports land in qa/lighthouse/.
qa/**
!qa/**/
!qa/**/*.md
# raw AI source PNGs for guides/icons (4-8 MB each; optimised copies live in public/)
design-v4/guide-assets/*.png
# 3D hero research sources (raw GLB + reference renders; the optimised model is in public/models/)
research/hero3d/*.png
research/hero3d/*.glb

# premium pass photo originals (Pexels/Unsplash/Wikimedia downloads, large; optimised copies in public/images/v5/, log in design-v4/photos-v5/manifest.json)
design-v4/photos-v5/raw/
