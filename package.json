{
  "name": "palmsays-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PalmSays (palmsays.com): the public website for the Palm Read AI Android app.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "check:web": "node scripts/check-web.mjs",
    "check:site": "node scripts/check-web.mjs",
    "shots": "node scripts/shots.mjs",
    "sync:palm": "node scripts/sync-palm-lib.mjs",
    "build:ci": "astro check && vitest run && astro build && node scripts/check-web.mjs",
    "gate": "npm run check && npm run lint && npm run test && npm run build && npm run check:web"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/react": "7.0.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
