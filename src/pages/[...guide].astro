---
/**
 * Every guide (src/content/guides/*.mdx) at its own path, e.g. /heart-line/
 * or /head-line/double/. Static routes (/, /app/, /tools/…) always win over
 * this rest route. Each guide must also be in src/config/pages.ts.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';

import LimitsBox from '../components/guides/LimitsBox.astro';
import Hi from '../components/guides/Hi.astro';
import Myth from '../components/guides/Myth.astro';
import MythReality from '../components/guides/MythReality.astro';
import PalmChart from '../components/guides/PalmChart.astro';
import PalmFigure from '../components/guides/PalmFigure.astro';
import ThreePart from '../components/guides/ThreePart.astro';
import ToolCard from '../components/guides/ToolCard.astro';
import Variation from '../components/guides/Variation.astro';
import Variations from '../components/guides/Variations.astro';
import GuideLayout from '../layouts/GuideLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { guide: entry.data.path.slice(1, -1) }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const components = { Hi, LimitsBox, Myth, MythReality, PalmChart, PalmFigure, ThreePart, ToolCard, Variation, Variations };
---

<GuideLayout entry={entry} headings={headings}>
  <Content components={components} />
</GuideLayout>
