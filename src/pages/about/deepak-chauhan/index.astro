---
/**
 * Author page (WEB-FEAT-035; SEO_PLAYBOOK.md §14, CONTENT_GUIDE.md §5 block 3).
 * Only facts the owner gave: Deepak Chauhan, founder, has built 6+ websites and apps, builds
 * PalmSays and writes its guides from the classical books. Never add credentials he doesn't have.
 * Stays noindex (registered indexable: false) until the owner sends the photo and short story
 * (owner item 4). Then:
 *   - photo: put it in public/media/people/ and set PORTRAIT below (the orb shows it);
 *   - story: set STORY below (a few short paragraphs in his own words);
 *   - registry: make /about/deepak-chauhan/ indexable (sitemap 'core') and add real sameAs links.
 */
import DocPage from '../../../components/trust/DocPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLive } from '../../../config/pages';
import { site } from '../../../config/site';
import { ORGANIZATION_ID, PERSON_ID } from '../../../lib/schema';

const path = '/about/deepak-chauhan/';
const brand = site.brand;
const name = site.author.name;

/** Owner item 4 (pending): { src: '/media/people/deepak-chauhan-400.webp', alt: 'Deepak Chauhan' }. */
const PORTRAIT = undefined as { src: string; alt: string } | undefined;
/** Owner item 4 (pending): his short story, one string per paragraph, in his words. */
const STORY: string[] = [];

const monogram = name
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .join('');

const guides = [
  { path: '/palm-reading/', name: 'How to read palm lines' },
  { path: '/hand-lines/', name: 'Lines on your palm and what they mean' },
  { path: '/heart-line/', name: 'Heart line' },
  { path: '/head-line/', name: 'Head line' },
  { path: '/life-line/', name: 'Life line' },
  { path: '/fate-line/', name: 'Fate line' },
  { path: '/is-palmistry-real/', name: 'Is palmistry true?' },
].filter((guide) => isLive(guide.path));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name,
  url: `${site.baseUrl}${path}`,
  jobTitle: 'Founder',
  worksFor: { '@id': ORGANIZATION_ID },
  // Palmistry (Wikidata Q182687) is what he writes about; no credentials he doesn't have (plan §5.2).
  knowsAbout: 'https://www.wikidata.org/wiki/Q182687',
  ...(PORTRAIT ? { image: `${site.baseUrl}${PORTRAIT.src}` } : {}),
};
---

<BaseLayout
  title={`${name}, founder of ${brand}`}
  description={`${name} is the founder of ${brand}. He builds the website and app and writes its palmistry guides from the classical books named on each page.`}
  path={path}
  locale="en"
  jsonLd={[person]}
>
  <DocPage
    crumb={name}
    path={path}
    parents={[{ name: 'About', path: '/about/' }]}
    icon="book"
    portrait={PORTRAIT}
    monogram={PORTRAIT ? undefined : monogram}
    kicker={`Founder of ${brand}`}
    title={name}
    lead={`${name} builds ${brand}, the app and this website, and writes its palmistry guides from the classical books named on each page.`}
  >
    <h2>About {name}</h2>
    <p>
      {name} is the founder of {brand}. He has built six or more websites and apps, and he builds this website and its Android app.
    </p>
    {STORY.map((paragraph) => <p>{paragraph}</p>)}

    <h2>How he writes the guides</h2>
    <p>
      He writes the {brand} guides from the classical palmistry books named in each guide’s sources, in plain words and with their
      limits stated. He is not a professional palm reader: the meanings on this site come from those books, not from personal
      readings. How every guide is sourced and checked is in our <a class="text-link" href="/editorial-policy/">editorial policy</a>.
    </p>
    {STORY.length === 0 && <p class="doc-note">A photo and a short note from {name} in his own words will be added here soon.</p>}

    {
      guides.length > 0 && (
        <>
          <h2>Guides he has written</h2>
          <ul>
            {guides.map((guide) => (
              <li>
                <a class="text-link" href={guide.path}>
                  {guide.name}
                </a>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </DocPage>
</BaseLayout>
