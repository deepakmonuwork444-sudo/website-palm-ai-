---
/**
 * Bilingual 404 (noindex, never in a sitemap). Served by Workers for any
 * unknown path (wrangler.jsonc not_found_handling: 404-page).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';

const en = t('en');
const hi = t('hi');
---

<BaseLayout title={en.meta.notFoundTitle} description={en.meta.notFoundDescription} path="/404" locale="en">
  <section class="wrap not-found">
    <h1 class="font-display text-h1 tracking-display-en">{en.notFound.title}</h1>
    <p class="text-lead text-fg-muted">{en.notFound.body}</p>
    <p><a class="btn btn-gold" href="/">{en.notFound.home}</a></p>
    <div lang="hi" class="not-found-hi">
      <h2 class="text-h2 font-bold">{hi.notFound.title}</h2>
      <p class="text-fg-muted">{hi.notFound.body}</p>
      <p><a class="text-link" href="/hi/">{hi.notFound.home}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { padding-block: 3rem 5rem; display: flex; flex-direction: column; gap: 1rem; }
  .not-found h1, .not-found h2, .not-found p { margin: 0; }
  .not-found-hi { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.75rem; }
  .not-found-hi a { display: inline-flex; align-items: center; min-height: 3rem; }
</style>
