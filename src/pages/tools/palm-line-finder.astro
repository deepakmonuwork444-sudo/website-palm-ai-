---
/**
 * Tool 2 — Palm line finder (KEYWORD_MAP.md §3: "palm line finder"; never
 * "scanner" in the title or H1, C7). It needs the scanning server
 * (WEB-SRV-004 lines-only mode), so while site.webReadingEnabled is false the
 * page is honest: "opens soon", a labelled drawn sample, no upload, and it is
 * noindex (src/config/pages.ts) so a page without its tool is never indexed.
 * Flipping the flag without building the live finder fails the build instead
 * of shipping a dead button (the same guard as the home UploadCard).
 */
import PalmTrace from '../../components/PalmTrace.astro';
import ToolLayout from '../../components/tools/ToolLayout.astro';
import { site } from '../../config/site';
import { MAP_SPOTS } from '../../lib/tools/palm-map';
import { toolById } from '../../lib/tools/registry';

if (site.webReadingEnabled) {
  throw new Error('palm-line-finder: webReadingEnabled is true, but the live line finder (WEB-FEAT-047) is not built yet.');
}

const tool = toolById('line-finder');
const lineSays = MAP_SPOTS.filter((spot) => spot.kind === 'line').map((spot) => ({ term: spot.name, text: spot.where }));
---

<ToolLayout
  tool={tool}
  title="Palm Line Finder: See Your Palm Lines Traced on Your Photo"
  description="Upload a palm photo and see your heart, head, life and fate lines traced and named. Lines only, no meanings. Uses AI; unclear lines are marked as unclear."
  h1="Palm line finder: see your palm lines traced"
  promise="Your heart, head, life and fate lines, traced and named on your own photo. Lines only — no meanings."
  ownPalm={false}
  howTitle="How it will work"
  how={[
    { title: 'Take a photo of your palm', body: 'Open palm, good light, the whole palm in the frame. The photo checker helps you get it right first.' },
    {
      title: 'Our AI traces the lines',
      body: 'The photo goes to our scanning server, which finds the heart, head, life and fate lines. A line it can’t see clearly is marked “not clearly seen”, never guessed.',
    },
    { title: 'See your lines named', body: 'Lines only, no meanings. For meanings, use the line finders or the full reading.' },
  ]}
  saysTitle="The lines it will look for"
  says={lineSays}
  limits={[
    'It will show lines only, with no meanings.',
    'Small marks — islands, stars, crosses — are too small for phone photos and are not traced.',
    'It is not open yet: nothing on this page uploads a photo.',
  ]}
  faq={[
    {
      q: 'When will the line finder open?',
      a: 'When the scanning server for the website is switched on. We won’t give a date we can’t keep.',
    },
    {
      q: 'Can I see my lines traced today?',
      a: 'Yes, in our Android app. It traces your lines on your own photo and explains each one.',
    },
    {
      q: 'Where will my photo go?',
      a: 'Before the finder opens, this page will say exactly where the photo is sent and what is kept. Nothing is sent from this page today.',
    },
    {
      q: 'Is there anything I can do now?',
      a: 'Check your photo with the palm photo checker so it is ready. It runs on your phone and uploads nothing.',
    },
  ]}
  links={[
    { href: '/hand-lines/', label: 'Lines on your palm and what they mean' },
    { href: '/tools/palm-photo-checker/', label: 'Palm photo checker' },
    { href: '/tools/palm-map/', label: 'Interactive palm map' },
    { href: '/app/', label: 'The PalmSays app' },
  ]}
>
  <div class="t-card" data-line-finder-soon>
    <div class="t-next">
      <p class="font-bold">The line finder opens soon on this website</p>
      <p>
        It needs our scanning server, which isn’t switched on for the website yet, so nothing here uploads a photo. Below is a sample of
        what it will show.
      </p>
      <p><a class="text-link" href="/tools/palm-photo-checker/">Get your photo ready with the photo checker</a></p>
    </div>
    <PalmTrace
      locale="en"
      id="line-finder-sample"
      size="compact"
      missing={['fate']}
      alt="Sample: a drawn palm with the life, head and heart lines traced. The fate line is not clearly seen, so it is not drawn."
      caption="Sample on a drawn palm, not a real photo. A line that isn’t clear is listed as “not clearly seen” and never drawn."
    />
  </div>
</ToolLayout>
