---
/**
 * Chips (DESIGN_SYSTEM.md §7.2). Not interactive: they must not look like buttons.
 * - promise: a static, true fact ("No payment on this site") with an outline icon.
 * - line: a line-colour dot + the name in both scripts; `missing` = dashed
 *   "not clearly seen" chip with a hollow dot (the line is never drawn).
 * - label: a small tag, e.g. "Sample".
 * Devanagari on an English page uses the system font (.script-system), so
 * English pages never download a Devanagari web font.
 */
import { en } from '../i18n/en';
import { hi } from '../i18n/hi';
import type { Locale } from '../config/site';
import Icon, { type IconName } from './Icon.astro';

type LineName = 'life' | 'head' | 'heart' | 'fate';

interface Props {
  variant: 'promise' | 'line' | 'label';
  locale: Locale;
  text?: string;
  icon?: IconName;
  line?: LineName;
  missing?: boolean;
}

const { variant, locale, text, icon, line, missing = false } = Astro.props;
const dict = locale === 'hi' ? hi : en;
const other = locale === 'hi' ? en : hi;
const otherLang = locale === 'hi' ? 'en' : 'hi';
---

{
  variant === 'promise' && (
    <span class="chip chip-promise text-small">
      {icon && <Icon name={icon} class="chip-icon" />}
      <span>{text}</span>
    </span>
  )
}
{variant === 'label' && <span class="chip chip-label text-caption">{text}</span>}
{
  variant === 'line' && line && (
    <span class:list={['chip chip-line text-small', { 'chip-missing': missing }]}>
      <span class:list={['dot', `dot-${line}`, { hollow: missing }]} aria-hidden="true" />
      <span class="chip-names">
        <span>{dict.lines[line].name}</span>
        <span lang={otherLang} class:list={['chip-other', { 'script-system': otherLang === 'hi' }]}>
          {other.lines[line].name}
        </span>
        {missing && <span class="chip-note">{dict.lines.notClearlySeen}</span>}
      </span>
    </span>
  )
}

<style>
  .chip { display: inline-flex; align-items: center; gap: 0.5rem; border-radius: 9999px; }
  .chip-promise { min-height: 2rem; padding: 0.25rem 0.875rem; background-color: var(--surface-2); border: 1px solid var(--edge); color: var(--fg); }
  .chip-promise :global(.chip-icon) { width: 1.05rem; height: 1.05rem; color: var(--accent); }
  .chip-label { padding: 0.125rem 0.625rem; background-color: var(--accent-soft); border: 1px solid var(--hairline); color: var(--fg); font-weight: 700; }
  .chip-line { min-height: 2.25rem; padding: 0.375rem 0.875rem 0.375rem 0.75rem; background-color: var(--surface-1); border: 1px solid var(--edge); color: var(--fg); }
  .chip-missing { border: 1.5px dashed var(--fg-muted); background-color: transparent; }
  .chip-names { display: inline-flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.5rem; }
  .chip-other { color: var(--fg-muted); }
  .chip-note { color: var(--fg-muted); flex-basis: 100%; font-size: var(--fs-caption); line-height: var(--lh-caption); }
  .dot { width: 0.625rem; height: 0.625rem; border-radius: 9999px; flex: none; }
  .dot-life { background-color: var(--line-life); }
  .dot-head { background-color: var(--line-head); }
  .dot-heart { background-color: var(--line-heart); }
  .dot-fate { background-color: var(--line-fate); }
  .dot.hollow { background-color: transparent; border: 1.5px solid var(--fg-muted); }
</style>
