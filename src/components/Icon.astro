---
/**
 * PalmSays icon set v4 (DESIGN_SYSTEM.md §8): our own solid duotone icons on a
 * 24px grid, drawn in src/lib/icons.ts (one source for the static pages and the
 * React island). Colour comes from `currentColor`; the second tone is the same
 * colour at 40 %. Decorative by default (aria-hidden); pass `label` when the icon
 * carries meaning on its own.
 */
import { ICONS, ICON_SVG_ATTRS, type IconName } from '../lib/icons';

export type { IconName };

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  {...ICON_SVG_ATTRS}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICONS[name]}
/>

<style>
  .icon { width: 1.25rem; height: 1.25rem; flex: none; }
</style>
