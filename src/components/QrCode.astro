---
/**
 * QR tile (DESIGN_SYSTEM.md §7.9): generated as SVG at build time (no QR
 * service), #0B0A1F modules on an #F6F0E1 tile (17.1:1) in both themes,
 * 4-module quiet zone, ≥ 132px (rendered at 176px), 12 radius, no logo.
 */
import { qrMatrix } from '../lib/qr';

interface Props {
  text: string;
  caption: string;
  label: string;
  class?: string;
}

const { text, caption, label, class: className } = Astro.props;
const { size, path } = qrMatrix(text);
---

<figure class:list={['qr', className]}>
  <svg class="qr-tile" viewBox={`0 0 ${size} ${size}`} role="img" aria-label={label} shape-rendering="crispEdges">
    <rect class="qr-light" width={size} height={size} rx={size * 0.068}></rect>
    <path class="qr-dark" d={path}></path>
  </svg>
  <figcaption class="text-small text-fg-muted">{caption}</figcaption>
</figure>

<style>
  .qr { margin: 0; display: inline-flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .qr-tile { width: 11rem; height: 11rem; display: block; }
  .qr-light { fill: var(--color-qr-light); }
  .qr-dark { fill: var(--color-qr-dark); }
</style>
