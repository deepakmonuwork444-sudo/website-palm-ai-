---
/** A labelled drawing inside a guide's text (a <figure> with a caption). */
import { localeFromPath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';
import { isVariant, VARIANTS, type Variant } from '../../lib/guides/palm-geometry';
import PalmDiagram from './PalmDiagram.astro';

interface Props {
  variant: string;
  alt: string;
  caption: string;
  id?: string;
}

const { variant, alt, caption, id } = Astro.props;
if (!isVariant(variant)) throw new Error(`PalmFigure: unknown drawing "${variant}"`);
const s = guideStrings(localeFromPath(Astro.url.pathname));
const anchor = id ?? `fig-${variant}`;
const edge = (VARIANTS[variant] as Variant).view === 'edge';
---

<figure class="palm-fig" id={anchor}>
  <div class:list={['palm-fig-art hero-fill', { edge }]}>
    <PalmDiagram variant={variant} id={`${anchor}-art`} label={alt} size="figure" />
  </div>
  <figcaption class="text-small text-fg-muted"><span class="fig-label text-caption">{s.figureLabel}</span> {caption}</figcaption>
</figure>

<style>
  .palm-fig { margin: 1.5rem 0 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .palm-fig-art { display: flex; justify-content: center; padding: 1.25rem; border-radius: 1.25rem; border: 1px solid var(--edge); }
  .palm-fig-art.edge { padding: 0; overflow: hidden; max-width: 22rem; }
  .fig-label { display: inline-block; padding: 0 0.5rem; margin-inline-end: 0.25rem; border-radius: 0.5rem; background-color: var(--surface-2); color: var(--fg); font-weight: 700; }
</style>
