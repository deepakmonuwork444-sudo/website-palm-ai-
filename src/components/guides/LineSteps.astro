---
/**
 * "Step n of 4" through the 4 main lines (guide template v3): heart → head →
 * life → fate. `top` is the small progress row under the byline; `end` is the
 * card at the bottom that leads on to the next line (or starts the 4 from a
 * hub). The bar shows where this page sits in the path; it never claims the
 * reader has done anything.
 */
import { isLive } from '../../config/pages';
import type { Locale } from '../../config/site';
import { localizePath } from '../../i18n';
import type { GuideLine } from '../../lib/guides/sample-palm';
import { guideStrings } from '../../lib/guides/strings';

interface Props {
  locale: Locale;
  /** This page's line; null on a page before the 4 (a hub, which hand to read). */
  current: GuideLine | null;
  variant: 'top' | 'end';
}

const LINES: { key: GuideLine; path: string }[] = [
  { key: 'heart', path: '/heart-line/' },
  { key: 'head', path: '/head-line/' },
  { key: 'life', path: '/life-line/' },
  { key: 'fate', path: '/fate-line/' },
];

const { locale, current, variant } = Astro.props;
const s = guideStrings(locale);
const items = LINES.map((line) => ({ ...line, href: localizePath(line.path, locale) })).filter((line) => isLive(line.href));
const index = current ? items.findIndex((line) => line.key === current) : -1;
const n = index + 1;
const next = index >= 0 ? items[index + 1] : items[0];
const chart = localizePath('/hand-lines/', locale);
const chartLive = isLive(chart) && Astro.url.pathname !== chart;
---

{
  items.length === 4 && (
    <nav class:list={['ls', `ls-${variant}`, { 'glass-panel guide-block': variant === 'end' }]} aria-label={s.linesNav}>
      {variant === 'top' && n > 0 && <p class="text-small font-bold ls-now">{s.stepOf4(n)}</p>}
      {variant === 'end' && (
        next ? (
          <a class="ls-next glass-card" href={next.href}>
            <span class="text-small text-fg-muted">{n > 0 ? s.nextLine(n + 1) : s.startLines}</span>
            <span class="text-h3 font-bold">{s.zoneName[next.key]}</span>
            <span class="ls-go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M13 6l6 6-6 6" /></svg></span>
          </a>
        ) : (
          <div class="ls-done">
            <p class="text-h3 font-bold">{s.allFour}</p>
            {chartLive && (
              <p>
                <a class="text-link" href={chart}>{s.allFourBody}</a>
              </p>
            )}
          </div>
        )
      )}
      <ol class="ls-bar">
        {items.map((line, i) => (
          <li class:list={['ls-step', `ls-${line.key}`, { 'ls-reached': i <= index, 'ls-current': i === index }]}>
            <a href={line.href} aria-current={i === index ? 'step' : undefined}>
              <span class="ls-track" />
              <span class="text-caption ls-name">{s.lineShort[line.key]}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .ls { display: flex; flex-direction: column; gap: 0.5rem; }
  .ls-now { margin: 0; color: var(--fg); letter-spacing: 0.01em; }
  .ls-bar { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.375rem; }
  .ls-step a { display: flex; flex-direction: column; gap: 0.375rem; min-height: 3rem; padding-top: 0.5rem; color: var(--fg-muted); text-decoration: none; }
  .ls-step a:hover .ls-name, .ls-step a:focus-visible .ls-name { color: var(--accent); text-decoration: underline; }
  /* Showroom: each track is a small glass groove; reached steps fill with light. */
  .ls-track {
    display: block; height: 0.375rem; border-radius: 0.5rem; background: var(--well);
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.45), 0 1px 0 rgba(255,255,255,0.05);
    transition: box-shadow 320ms var(--ease-out);
  }
  :global([data-theme="day"]) .ls-track { background: var(--surface-3); box-shadow: inset 0 1px 2px rgba(23,19,61,0.12); }
  .ls-reached .ls-track { background: linear-gradient(90deg, var(--color-gold-pressed), var(--color-gold-bright)); box-shadow: none; }
  :global([data-theme="day"]) .ls-reached .ls-track { background: var(--accent); box-shadow: none; }
  .ls-heart.ls-current .ls-track { background: var(--line-heart); box-shadow: 0 0 14px -2px color-mix(in srgb, var(--line-heart) 75%, transparent); }
  .ls-head.ls-current .ls-track { background: var(--line-head); box-shadow: 0 0 14px -2px color-mix(in srgb, var(--line-head) 75%, transparent); }
  .ls-life.ls-current .ls-track { background: var(--line-life); box-shadow: 0 0 14px -2px color-mix(in srgb, var(--line-life) 75%, transparent); }
  .ls-fate.ls-current .ls-track { background: var(--line-fate); box-shadow: 0 0 14px -2px color-mix(in srgb, var(--line-fate) 75%, transparent); }
  .ls-step a:hover .ls-track { box-shadow: inset 0 1px 2px rgba(0,0,0,0.3), 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent); }
  .ls-current .ls-name { color: var(--fg); font-weight: 700; }

  .ls-end { margin-top: 3.5rem; padding: 1.25rem; gap: 0.875rem; }
  .ls-next {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: 1rem; row-gap: 0.125rem; align-items: center;
    min-height: 3rem; padding: 1rem 1.25rem; border-radius: var(--r-well); color: var(--fg); text-decoration: none;
  }
  .ls-next > span:not(.ls-go) { grid-column: 1; }
  /* A small gold arrow in a lit ring (decorative). */
  .ls-go {
    grid-column: 2; grid-row: 1 / span 2; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent); color: var(--accent);
    transition: transform 420ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }
  .ls-go svg { width: 1.125rem; height: 1.125rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ls-next:hover .ls-go { transform: translateX(3px); box-shadow: none; }
  .ls-done p { margin: 0 0 0.25rem; }
  @media (min-width: 40rem) { .ls-end { padding: 1.5rem 1.75rem 1.25rem; } }
</style>
