---
/** One myth and its reality, inside <MythReality>. The reality is the slot. */
import { localeFromPath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';

interface Props {
  claim: string;
}

const { claim } = Astro.props;
const s = guideStrings(localeFromPath(Astro.url.pathname));
---

<div class="myth">
  <dt><span class="tag tag-myth text-caption">{s.myth}</span><span class="myth-claim">{claim}</span></dt>
  <dd><span class="tag tag-reality text-caption">{s.reality}</span><div class="myth-reality"><slot /></div></dd>
</div>

<style>
  .myth { display: grid; gap: 0.75rem; padding: 1.25rem; border-radius: 1.25rem; background-color: var(--surface-1); border: 1px solid var(--edge); }
  .myth dt, .myth dd { margin: 0; display: flex; flex-direction: column; gap: 0.375rem; align-items: flex-start; }
  .myth-claim { font-weight: 700; }
  .myth-reality :global(p) { margin: 0; }
  .tag { padding: 0.125rem 0.625rem; border-radius: 0.5rem; font-weight: 700; border: 1px solid var(--edge); }
  .tag-myth { background-color: var(--surface-2); color: var(--fg-muted); }
  .tag-reality { background-color: var(--accent-soft); color: var(--fg); border-color: var(--hairline); }
  @media (min-width: 64rem) {
    .myth { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 2rem; }
  }
</style>
