---
/**
 * The labelled palm reading chart for /hand-lines/ (SEO_PLAYBOOK.md §3,
 * "Palm reading chart: every line at a glance"). The same drawn hand as
 * PalmTrace, with the four main lines in their trace colours, the minor lines
 * in gold, a numbered badge on each, and a real <ol> legend underneath (the
 * numbers are never the only label). Static SVG, no JS.
 */
import { localeFromPath } from '../../i18n';
import { BASE_PATHS, PALM_OUTLINE, PALM_VIEWBOX } from '../../lib/guides/palm-geometry';

interface Props {
  alt: string;
  caption: string;
}

const { alt, caption } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);

const lines = [
  { n: 1, name: 'Heart line', hi: 'हृदय रेखा', kind: 'heart', d: [BASE_PATHS.heart], at: [101, 138] },
  { n: 2, name: 'Head line', hi: 'मस्तिष्क रेखा', kind: 'head', d: [BASE_PATHS.head], at: [97, 184] },
  { n: 3, name: 'Life line', hi: 'जीवन रेखा', kind: 'life', d: [BASE_PATHS.life], at: [144, 214] },
  { n: 4, name: 'Fate line', hi: 'भाग्य रेखा', kind: 'fate', d: [BASE_PATHS.fate], at: [104, 224] },
  { n: 5, name: 'Sun line', hi: 'सूर्य रेखा', kind: 'minor', d: ['M90 200 C 90 180, 89 160, 88 138'], at: [98, 166] },
  { n: 6, name: 'Mercury line', hi: 'बुध रेखा', kind: 'minor', d: ['M104 244 C 92 216, 78 184, 62 150'], at: [70, 206] },
  { n: 7, name: 'Marriage lines', hi: 'विवाह रेखा', kind: 'minor', d: ['M50 134 C 53 134, 57 133.5, 60 133', 'M50 140 C 53 140, 56 139.5, 59 139'], at: [43, 137] },
  { n: 8, name: 'Bracelets (wrist lines)', hi: 'मणिबंध', kind: 'minor', d: ['M76 247 C 100 250, 126 250, 146 247'], at: [158, 245] },
] as const;
---

<figure class="chart" id="palm-chart">
  <div class="chart-art hero-fill">
    <svg class="chart-svg" viewBox={PALM_VIEWBOX} role="img" aria-label={alt}>
      <defs>
        <linearGradient id="chart-skin" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" class="stop-top"></stop>
          <stop offset="1" class="stop-bottom"></stop>
        </linearGradient>
      </defs>
      <path class="palm" fill="url(#chart-skin)" d={PALM_OUTLINE}></path>
      {lines.map((line) => line.d.map((d) => <path class="halo" d={d}></path>))}
      {lines.map((line) => line.d.map((d) => <path class:list={['trace', `t-${line.kind}`]} d={d}></path>))}
      {
        lines.map((line) => (
          <g class="badge" aria-hidden="true">
            <circle cx={line.at[0]} cy={line.at[1]} r="5.4"></circle>
            <text x={line.at[0]} y={line.at[1]} dy="2.4">{line.n}</text>
          </g>
        ))
      }
    </svg>
  </div>
  <figcaption>
    <ol class="chart-legend">
      {
        lines.map((line) => (
          <li>
            <span class:list={['legend-dot', `d-${line.kind}`]} aria-hidden="true"></span>
            <span class="font-bold">{line.name}</span>
            <span lang="hi" class:list={['text-fg-muted', { 'script-system': locale === 'en' }]}>{line.hi}</span>
          </li>
        ))
      }
    </ol>
    <p class="text-small text-fg-muted chart-caption">{caption}</p>
  </figcaption>
</figure>

<style>
  .chart { margin: 1.5rem 0 2rem; display: flex; flex-direction: column; gap: 1rem; }
  .chart-art { display: flex; justify-content: center; padding: 1.25rem; border-radius: 1.25rem; border: 1px solid var(--edge); }
  .chart-svg { display: block; width: 100%; max-width: 22rem; height: auto; }
  .stop-top { stop-color: var(--color-palm-top); }
  .stop-bottom { stop-color: var(--color-palm-bottom); }
  .palm { stroke: color-mix(in srgb, var(--color-gold) 38%, transparent); stroke-width: 1.2; stroke-linejoin: round; }
  .halo, .trace { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .halo { stroke: var(--color-halo); stroke-width: 4; }
  .trace { stroke-width: 2.4; }
  .t-heart { stroke: var(--color-trace-heart); }
  .t-head { stroke: var(--color-trace-head); }
  .t-life { stroke: var(--color-trace-life); }
  .t-fate { stroke: var(--color-trace-fate); }
  .t-minor { stroke: var(--color-gold-bright); stroke-width: 1.8; }
  .badge circle { fill: var(--color-gold); stroke: var(--color-halo); stroke-width: 1; }
  .badge text { fill: var(--color-on-gold); font-family: var(--ff-sans); font-size: 7px; font-weight: 700; text-anchor: middle; }
  .chart-legend { margin: 0; padding-inline-start: 1.75rem; list-style: decimal; display: grid; gap: 0.375rem; }
  .chart-legend li::marker { color: var(--accent); font-weight: 700; }
  .chart-legend li { padding-inline-start: 0.25rem; }
  .legend-dot { display: inline-block; width: 0.625rem; height: 0.625rem; border-radius: 9999px; margin-inline-end: 0.5rem; vertical-align: 0.05em; }
  .d-heart { background-color: var(--line-heart); }
  .d-head { background-color: var(--line-head); }
  .d-life { background-color: var(--line-life); }
  .d-fate { background-color: var(--line-fate); }
  .d-minor { background-color: var(--accent); }
  .chart-legend li span + span { margin-inline-start: 0.5rem; }
  .chart-caption { margin: 0; }
  @media (min-width: 48rem) { .chart-legend { grid-template-columns: 1fr 1fr; column-gap: 2rem; } }
</style>
