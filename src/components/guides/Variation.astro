---
/**
 * One variation card (DESIGN_SYSTEM.md §7.8 VariationCard): a drawing of the
 * shape, an H3 name, the meaning in our words (the slot) and a source chip.
 * Used inside <Variations>. Stacked on mobile, two per row on desktop.
 */
import { localeFromPath } from '../../i18n';
import { BOOKS, isBookId, type BookId } from '../../lib/guides/books';
import { guideStrings } from '../../lib/guides/strings';
import { isVariant } from '../../lib/guides/palm-geometry';
import PalmDiagram from './PalmDiagram.astro';

interface Props {
  /** A shape from src/lib/guides/palm-geometry.ts. */
  variant: string;
  title: string;
  /** What the drawing shows (alt text). */
  alt: string;
  /** Book ids from src/lib/guides/books.ts. */
  src: string[];
  id?: string;
}

const { variant, title, alt, src, id } = Astro.props;
if (!isVariant(variant)) throw new Error(`Variation: unknown drawing "${variant}"`);
const unknown = src.filter((book) => !isBookId(book));
if (unknown.length) throw new Error(`Variation "${title}": unknown book id(s) ${unknown.join(', ')}`);

const s = guideStrings(localeFromPath(Astro.url.pathname));
// "Cheiro (1916, 1900); Leo Markun (1927)": one entry per author, years in citation order.
const byAuthor = new Map<string, number[]>();
for (const book of src as BookId[]) {
  const { author, year } = BOOKS[book];
  const years = byAuthor.get(author) ?? [];
  if (!years.includes(year)) byAuthor.set(author, [...years, year]);
  else byAuthor.set(author, years);
}
const chip = [...byAuthor].map(([author, years]) => `${author} (${years.join(', ')})`).join('; ');
const anchor = id ?? `type-${variant}`;
---

<li class="variation" id={anchor}>
  <div class="variation-art">
    <PalmDiagram variant={variant} id={`${anchor}-art`} label={alt} />
  </div>
  <div class="variation-body">
    <h3 class="text-h3 font-bold variation-title">{title}</h3>
    <div class="variation-text">
      <slot />
      <p class="text-caption text-fg-muted variation-source"><span class="font-bold">{s.sourceLabel}:</span> {chip}</p>
    </div>
  </div>
</li>

<style>
  /* Phones: drawing and name side by side, the meaning full width below. Wider: drawing beside everything. */
  .variation {
    display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); grid-template-areas: 'art title' 'text text';
    column-gap: 1rem; row-gap: 0.75rem; align-items: center;
    padding: 1rem; border-radius: 1.25rem; background-color: var(--surface-1); border: 1px solid var(--edge);
  }
  .variation-art { grid-area: art; border-radius: 0.75rem; overflow: hidden; }
  .variation-body { display: contents; }
  .variation-title { grid-area: title; margin: 0; }
  .variation-text { grid-area: text; }
  .variation-text :global(p) { margin: 0 0 0.5rem; }
  .variation-text :global(p:last-child) { margin-bottom: 0; }
  .variation-source { margin: 0.625rem 0 0; }
  @media (min-width: 48rem) {
    .variation {
      grid-template-columns: 7.5rem minmax(0, 1fr); grid-template-areas: 'art title' 'art text';
      grid-template-rows: auto 1fr; padding: 1.25rem; column-gap: 1.25rem; row-gap: 0.375rem; align-items: start;
    }
  }
</style>
