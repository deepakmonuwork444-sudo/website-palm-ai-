---
/**
 * One variation card (guide template v3, DESIGN_SYSTEM.md §7.8 VariationCard):
 * a small drawing of the shape, the name, the short meaning (`gist`) and a
 * "Do you have this?" self-check the reader does on their own hand. The
 * books' fuller reading (the slot) and its source chip sit one tap away in a
 * native <details>, so the grid stays scannable. Used inside <Variations>.
 */
import { localeFromPath } from '../../i18n';
import { BOOKS, isBookId, type BookId } from '../../lib/guides/books';
import { inlineMarkdown } from '../../lib/guides/guides';
import { guideStrings } from '../../lib/guides/strings';
import { isVariant } from '../../lib/guides/palm-geometry';
import PalmDiagram from './PalmDiagram.astro';

interface Props {
  /** A shape from src/lib/guides/palm-geometry.ts. */
  variant: string;
  title: string;
  /** What the drawing shows (alt text). */
  alt: string;
  /** Book ids from src/lib/guides/books.ts. */
  src: string[];
  /** The meaning in one short line (≤ 16 words): what a reader takes away in 3 seconds. */
  gist: string;
  /** "Do you have this?": what to look for on your own hand. */
  check: string;
  id?: string;
  /**
   * Heading level of the card title. 4 (default): the card is a VALUE under an attribute
   * question H3 (entity → attribute → value, heading spec in SEMANTIC_SEO_PLAN.md §3.2,
   * WEB-DEC-051). 3: cards that sit straight under an H2 (no question group).
   */
  level?: 3 | 4;
}

const { variant, title, alt, src, gist, check, id, level = 4 } = Astro.props;
const Title = level === 3 ? 'h3' : 'h4';
if (!isVariant(variant)) throw new Error(`Variation: unknown drawing "${variant}"`);
const unknown = src.filter((book) => !isBookId(book));
if (unknown.length) throw new Error(`Variation "${title}": unknown book id(s) ${unknown.join(', ')}`);
const locale = localeFromPath(Astro.url.pathname);
const s = guideStrings(locale);
// "Cheiro (1916, 1900); Leo Markun (1927)": one entry per author, years in citation order.
const byAuthor = new Map<string, number[]>();
for (const book of src as BookId[]) {
  const { author, year } = BOOKS[book];
  const years = byAuthor.get(author) ?? [];
  byAuthor.set(author, years.includes(year) ? years : [...years, year]);
}
const chip = [...byAuthor].map(([author, years]) => `${author} (${years.join(', ')})`).join('; ');
const anchor = id ?? `type-${variant}`;
---

<li class="vc glass-card" id={anchor}>
  <div class="vc-head">
    <div class="vc-art glass-well">
      <PalmDiagram variant={variant} id={`${anchor}-art`} label={alt} />
    </div>
    <Title class="font-bold vc-title">{title}</Title>
  </div>
  <p class="vc-gist" set:html={inlineMarkdown(gist, locale)} />
  <p class="text-small vc-check">
    <svg class="vc-eye" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
    <span><span class="font-bold">{s.doYouHave}</span> <span set:html={inlineMarkdown(check, locale)} /></span>
  </p>
  <details class="vc-more">
    <summary class="text-small font-bold">{s.booksSay}</summary>
    <div class="vc-text">
      <slot />
      <p class="text-caption text-fg-muted vc-source"><span class="font-bold">{s.sourceLabel}:</span> {chip}</p>
    </div>
  </details>
</li>

<style>
  /* Showroom: a rim-lit glass card; the drawing sits in an inset well. */
  .vc { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; padding: 1.125rem 1.25rem 0.25rem; }
  .vc:target { background: var(--glass-1) padding-box, var(--rim-hover) border-box; box-shadow: var(--e2); }
  .vc-head { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1rem; align-items: center; }
  .vc-art { position: relative; padding: 0.375rem; overflow: hidden; }

  /* The same look at h3 or h4: the serif and weight the global h3 rule gives (global.css). */
  .vc-title { margin: 0; font-family: var(--ff-display); font-weight: 700; letter-spacing: -0.005em; text-wrap: balance; font-size: calc(var(--fs-h3) * 0.95); line-height: 1.2; }
  :global(:lang(hi)) .vc-title { font-size: var(--fs-body); line-height: 1.5; }
  .vc-gist { margin: 0; color: var(--fg); }
  .vc-check {
    margin: 0; display: grid; grid-template-columns: 1.25rem minmax(0, 1fr); gap: 0.5rem; align-items: start; color: var(--fg-muted);
    padding: 0.625rem 0.75rem; border-radius: 0.75rem; background: var(--well);
  }
  .vc-check .font-bold { color: var(--fg); }
  .vc-eye { width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; fill: none; stroke: var(--accent); stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .vc-more { margin-top: auto; border-top: 1px solid var(--edge); }
  .vc-more summary {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 3rem;
    cursor: pointer; list-style: none; color: var(--accent);
  }
  .vc-more summary::-webkit-details-marker { display: none; }
  /* The plus turns into a minus. */
  .vc-more summary::after {
    content: ""; flex: none; width: 1.75rem; height: 1.75rem; border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background:
      linear-gradient(var(--accent), var(--accent)) center / 0.625rem 1.5px no-repeat,
      linear-gradient(var(--accent), var(--accent)) center / 1.5px 0.625rem no-repeat;
    transition: transform 360ms var(--ease-out), background-size 360ms var(--ease-out);
  }
  .vc-more[open] summary::after {
    transform: rotate(180deg);
    background:
      linear-gradient(var(--accent), var(--accent)) center / 0.625rem 1.5px no-repeat,
      linear-gradient(var(--accent), var(--accent)) center / 1.5px 0 no-repeat;
  }
  .vc-text { padding-bottom: 1rem; }
  .vc-text :global(p) { margin: 0 0 0.5rem; }
  .vc-text :global(p:last-child) { margin-bottom: 0; }
  .vc-source { margin-top: 0.625rem; }
  @supports selector(::details-content) {
    .vc-more { interpolate-size: allow-keywords; }
    .vc-more::details-content { block-size: 0; overflow: hidden; opacity: 0; transition: block-size 420ms var(--ease-out), opacity 300ms var(--ease), content-visibility 420ms allow-discrete; }
    .vc-more[open]::details-content { block-size: auto; opacity: 1; }
  }
</style>
