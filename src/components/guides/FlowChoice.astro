---
/**
 * "Heart or head line?" / "Life or fate line?" (guide v4, the line guides):
 * one question, two answers, each on a crop of the same real photo with the
 * scanner's own line and a dot on its start, plus one link for the tricky case.
 * The words carry the answer, never the colour alone. Zero JS.
 */
import { localeFromPath, localizePath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';
import { guideScan, lineEnds, startsCrop, type GuideLine } from '../../lib/guides/traced-palm';
import PhotoCrop from './PhotoCrop.astro';
import './teach.css';

interface Props {
  pair?: 'heart-head' | 'life-fate';
}

const { pair = 'heart-head' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const t = guideStrings(locale).teach;
const lines: [GuideLine, GuideLine] = pair === 'life-fate' ? ['life', 'fate'] : ['heart', 'head'];
const f = pair === 'life-fate' ? t.flowChoiceLF : t.flowChoice;
const words = f as unknown as Record<GuideLine, { where: string; is: string; alt: string }>;
const scan = guideScan();
const box = startsCrop(scan, lines);
const r = Math.round(box.w * 0.02 * 10) / 10;
const choices = lines.map((line) => ({ line, ...words[line], start: lineEnds(scan, line)?.start ?? null }));
const oneHref = f.oneHref.startsWith('#') ? f.oneHref : localizePath(f.oneHref, locale);
---

<figure class="tb tb-fc glass-panel tb-box">
  <p class="tb-title">{f.title}</p>
  <p>{f.q}</p>
  <ul class="tb-fc-opts">
    {
      choices.map((choice) => (
        <li class="tb-well">
          <PhotoCrop box={box} lines={[choice.line]} alt={choice.alt}>
            {choice.start && <circle class="tb-start" cx={choice.start[0]} cy={choice.start[1]} r={r} />}
          </PhotoCrop>
          <p>
            <strong>{choice.where}:</strong> {choice.is}
          </p>
        </li>
      ))
    }
  </ul>
  <p class="tb-fc-one">
    {f.one} <a class="text-link" href={oneHref}>{f.oneLink}</a>
  </p>
  <figcaption>{f.caption}</figcaption>
</figure>
