---
/**
 * Photo tips (CONTENT_GUIDE.md §5 block 14): 3 tips, what a phone photo can't
 * show (§4.6), and a link to the palm photo checker once that tool is live.
 */
import { isLive } from '../../config/pages';
import { localeFromPath, localizePath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';

const locale = localeFromPath(Astro.url.pathname);
const s = guideStrings(locale);
const checker = localizePath('/tools/palm-photo-checker/', locale);
const showChecker = isLive(checker);
---

<section class="tips" aria-labelledby="photo-tips-title">
  <h2 id="photo-tips-title" class="text-h3 font-bold">{s.photoTitle}</h2>
  <ol class="tips-list">
    {s.photoTips.map((tip) => <li>{tip}</li>)}
  </ol>
  <p class="text-small text-fg-muted">{s.photoCantShow}</p>
  {showChecker && <p class="text-small"><a class="text-link" href={checker}>{s.photoCheckerLink}</a></p>}
</section>

<style>
  .tips { margin-top: 3rem; padding: 1.25rem; border-radius: 1.25rem; border: 1px solid var(--edge); background-color: var(--surface-1); }
  .tips h2 { margin: 0 0 0.75rem; }
  .tips-list { margin: 0 0 1rem; padding-inline-start: 1.5rem; list-style: decimal; display: flex; flex-direction: column; gap: 0.5rem; }
  .tips-list li::marker { color: var(--accent); font-weight: 700; }
  .tips p { margin: 0 0 0.5rem; }
  .tips p:last-child { margin-bottom: 0; }
</style>
