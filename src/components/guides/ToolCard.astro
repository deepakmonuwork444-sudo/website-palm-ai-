---
/**
 * Tool card (CONTENT_GUIDE.md §5 block 11, DESIGN_SYSTEM.md §7.7): links to
 * the tool's own page and never embeds a copy (owner decision: one home per
 * tool). Rendered only once that tool page is live, so a guide never links
 * to a page that doesn't exist yet. The link is the tool name only (WEB-DEC-051 R6);
 * it stretches over the card, so the whole card stays one tap target.
 */
import { isLive } from '../../config/pages';
import { localeFromPath, localizePath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';
import { TOOLS } from '../../lib/tools/registry';
import { TOOL_ICON } from '../../lib/tools/tool-icons';
import MediaIcon from '../MediaIcon.astro';

interface Props {
  /** The tool's slug under /tools/. */
  slug: string;
  name: string;
  /** The question the tool answers (kept for the link graph; the card shows the tool name). */
  question?: string;
  /** One line on what you get. */
  text: string;
  /** The tool's honesty label, e.g. "Traditional meanings — not AI". */
  label: string;
  /** Kept for older callers; the card shows the tool's own icon. */
  line?: 'heart' | 'head' | 'life' | 'fate';
}

const { slug, name, text, label } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const href = localizePath(`/tools/${slug}/`, locale);
const live = isLive(href);
const s = guideStrings(locale);
// The tool's own icon (one per tool); a card for a tool not in the registry shows no mark.
const tool = TOOLS.find((item) => item.path === `/tools/${slug}/`);
const icon = tool ? TOOL_ICON[tool.id] : null;
---

{
  live && (
    <div class:list={["tool-card glass-card", { "no-mark": !icon }]}>
      {icon && <span class="tool-mark glass-well" aria-hidden="true"><MediaIcon name={icon} class="tool-mark-icon" /></span>}
      <span class="tool-copy">
        <a class="text-h3 font-bold tool-name stretch-link" href={href}>{name}</a>
        <span class="tool-text">{text}</span>
        <span class="tool-label text-caption">{label}</span>
        <span class="tool-action">{s.toolCardAction(name)}</span>
      </span>
    </div>
  )
}

<style>
  /* Showroom: a rim-lit glass card that lifts on hover, like the home tool cards. */
  .tool-card {
    display: grid; grid-template-columns: 3.75rem minmax(0, 1fr); gap: 1rem; margin: 2rem 0 2.5rem; padding: 1.25rem;
    color: var(--fg); text-decoration: none;
  }
  .tool-card:hover .tool-action, .tool-card:has(.stretch-link:focus-visible) .tool-action { text-decoration-thickness: 2px; }
  .tool-mark { display: grid; place-items: center; width: 3.75rem; height: 3.75rem; }
  .tool-mark :global(.tool-mark-icon) { width: 2.5rem; }
  .tool-card.no-mark { grid-template-columns: minmax(0, 1fr); }
  .tool-name { font-family: var(--ff-display); }
  .tool-copy { display: flex; flex-direction: column; gap: 0.375rem; align-items: flex-start; }
  .tool-label {
    padding: 0.125rem 0.625rem; border-radius: 9999px; color: var(--fg); border: 1px solid transparent;
    background: var(--well) padding-box, var(--rim) border-box;
  }
  .tool-action { color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  @media (min-width: 40rem) { .tool-card { padding: 1.5rem 1.75rem; gap: 1.25rem; } }
</style>
