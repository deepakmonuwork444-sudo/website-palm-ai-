---
/** Related guides (CONTENT_GUIDE.md §5 block 19): 3–4 text links with line glyphs; live pages only. */
import { localeFromPath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';
import Icon from '../Icon.astro';

type Line = 'heart' | 'head' | 'life' | 'fate';

interface Props {
  items: { path: string; name: string; line?: Line | undefined }[];
  /** A heading with the entity ("Related palm lines" on the line guides, WEB-DEC-051). */
  title?: string | undefined;
}

const { items, title } = Astro.props;
const s = guideStrings(localeFromPath(Astro.url.pathname));
---

{
  items.length > 0 && (
    <nav class="related" aria-labelledby="related-title">
      <h2 id="related-title" class="text-h3 font-bold">
        {title ?? s.relatedTitle}
      </h2>
      <ul>
        {items.map((item) => (
          <li>
            <a class="related-link glass-card" href={item.path}>
              <span class="related-mark glass-well" aria-hidden="true">
                <svg class:list={['related-glyph', item.line ? `glyph-${item.line}` : 'glyph-minor']} viewBox="0 0 48 24" aria-hidden="true">
                  <path class="glyph-halo" d="M4 18 C 16 6, 30 6, 44 12" />
                  <path class="glyph-line" d="M4 18 C 16 6, 30 6, 44 12" />
                </svg>
              </span>
              <span class="related-name">{item.name}</span>
              <span class="related-go" aria-hidden="true"><Icon name="chevron" class="related-go-icon" /></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* Showroom: glass cards that match the home guide cards (glyph in a well, serif name, lift on hover). */
  .related { margin-top: 3rem; }
  .related h2 { margin: 0 0 1rem; }
  .related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .related li { min-width: 0; }
  .related-link {
    display: flex; align-items: center; gap: 1rem; min-height: 3.5rem; padding: 0.75rem 1rem 0.75rem 0.75rem; border-radius: var(--r-card);
    color: var(--fg); text-decoration: none;
  }
  .related-mark { display: grid; place-items: center; flex: none; width: 3rem; height: 3rem; border-radius: 0.875rem; }
  .related-glyph { width: 2.25rem; height: 1.125rem; }
  .related-name { flex: 1; min-width: 0; font-family: var(--ff-display); font-weight: 700; font-size: calc(var(--fs-h3) * 1.02); line-height: 1.2; }
  :global(:lang(hi)) .related-name { font-family: var(--ff-sans); font-size: var(--fs-body); }
  .related-go { display: grid; place-items: center; flex: none; width: 2rem; height: 2rem; color: var(--accent); transition: transform 360ms var(--ease-out); }
  .related-go :global(.related-go-icon) { width: 1.125rem; height: 1.125rem; }
  .related-link:hover .related-go, .related-link:focus-visible .related-go { transform: translateX(3px); }
  .related-link:hover .related-name { color: var(--accent); }
  .glyph-halo { fill: none; stroke: var(--color-halo); stroke-width: 6; stroke-linecap: round; }
  .glyph-line { fill: none; stroke-width: 3.5; stroke-linecap: round; }
  .glyph-heart .glyph-line { stroke: var(--line-heart); }
  .glyph-head .glyph-line { stroke: var(--line-head); }
  .glyph-life .glyph-line { stroke: var(--line-life); }
  .glyph-fate .glyph-line { stroke: var(--line-fate); }
  .glyph-minor .glyph-line { stroke: var(--accent); }
  :global([data-theme="day"]) .glyph-halo { display: none; }
  @media (min-width: 48rem) { .related ul { grid-template-columns: 1fr 1fr; gap: 0.875rem; } }
</style>
