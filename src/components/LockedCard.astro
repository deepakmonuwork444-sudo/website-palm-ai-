---
/**
 * Locked part of a reading (DESIGN_SYSTEM.md §7.6): the title, its REAL first
 * sentence fully readable, and a pill. The whole card is the tap target.
 * No blur, no "██", no hidden text: the rest of the part is never in the DOM.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  firstSentence: string;
  href: string;
  actionLabel: string;
  lockedLabel: string;
}

const { title, firstSentence, href, actionLabel, lockedLabel } = Astro.props;
---

<a class="locked" href={href}>
  <span class="locked-head">
    <span class="text-h3 font-bold locked-title">{title}</span>
    <span class="locked-tag text-caption"><Icon name="lock" class="locked-icon" /><span>{lockedLabel}</span></span>
  </span>
  <span class="locked-text">{firstSentence}</span>
  <span class="locked-pill text-small">{actionLabel}</span>
</a>

<style>
  .locked {
    display: flex; flex-direction: column; gap: 0.75rem; padding: 1.25rem; border-radius: 1.25rem;
    background-color: var(--surface-1); border: 1px solid var(--edge); color: var(--fg); text-decoration: none;
    background-image: linear-gradient(180deg, transparent 55%, var(--accent-soft));
    transition: transform var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .locked:hover { border-color: var(--hairline); }
  .locked:active { transform: scale(0.98); }
  .locked-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; }
  .locked-tag { display: inline-flex; align-items: center; gap: 0.375rem; color: var(--fg-muted); white-space: nowrap; }
  .locked-tag :global(.locked-icon) { width: 1rem; height: 1rem; }
  .locked-pill {
    align-self: flex-start; display: inline-flex; align-items: center; min-height: 2.25rem; padding: 0.25rem 0.875rem;
    border-radius: 9999px; background-color: var(--surface-2); border: 1px solid var(--control-border); color: var(--fg); font-weight: 700;
  }
</style>
