<style>
  .logo-mark { width: 1.75rem; height: auto; flex: none; }
  .logo-word { height: 1.05rem; width: auto; fill: var(--fg); }
  .logo-palm { fill: var(--color-gold); stroke: var(--color-gold); stroke-width: 6; stroke-linejoin: round; }
  .logo-lines path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .logo-halo { stroke: var(--color-halo); stroke-width: 11; }
  .logo-heart { stroke: var(--color-logo-heart); stroke-width: 7; }
  .logo-head { stroke: var(--color-logo-head); stroke-width: 7; }
  .logo-life { stroke: var(--color-logo-life); stroke-width: 7; }
</style>
