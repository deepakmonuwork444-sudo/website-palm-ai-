---
/**
 * PalmSays logo: the app's gold palm mark (heart, head and life lines in the
 * logo's own colours, DESIGN_SYSTEM.md §2.3) + the Cinzel wordmark.
 * The wordmark is outlined paths (Cinzel 700, generated once with fontkitten),
 * so no Cinzel web font is ever loaded (§3.1).
 */
import { site } from '../config/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
