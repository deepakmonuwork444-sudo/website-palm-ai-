---
/**
 * Feature-size icon (reveal cards, tool tiles, guide cards, legal heroes, /app/
 * features): the bespoke solid duotone set (Icon.astro, src/lib/icons.ts) in the
 * accent colour, square at whatever width the caller sets, so it fills its tile
 * instead of sitting small in an empty box. Decorative: always next to a visible label.
 */
import Icon, { type IconName } from './Icon.astro';

export type MediaIconName = IconName;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<Icon name={name} class:list={['media-icon', className]} />

<style is:global>
  svg.media-icon.icon { display: block; flex: none; width: 2.5rem; height: auto; aspect-ratio: 1; color: var(--accent); }
</style>
