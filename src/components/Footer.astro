---
/**
 * Site footer (DESIGN_SYSTEM.md §7.11). Links only to live pages; the company
 * block appears only once the owner's details are in site.ts (owner item 9).
 * "No cookies, no ad trackers" is shown only while site.cookieFree is true.
 */
import { findPage, isLive } from '../config/pages';
import { site, type Locale } from '../config/site';
import { localizePath, t } from '../i18n';
import Logo from './Logo.astro';
import StoreButton from './StoreButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = localizePath('/', locale);
const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  page: string;
  /** Language of the target when it differs (the legal pages are English). */
  lang?: string;
}

const groups: { title: string; links: FooterLink[] }[] = [
  {
    title: dict.footer.groups.read,
    links: [
      { label: dict.nav.sample, href: `${home}#sample`, page: home },
      { label: dict.nav.howItWorks, href: `${home}#how-it-works`, page: home },
    ],
  },
  {
    // Guides: labels come from the page registry (English guides only until Hindi twins are reviewed).
    title: dict.footer.groups.guides,
    links: ['/palm-reading/', '/hand-lines/', '/heart-line/', '/head-line/', '/life-line/', '/fate-line/', '/which-hand-to-read/', '/is-palmistry-real/']
      .map((path) => localizePath(path, locale))
      .map((path) => ({ label: findPage(path)?.label ?? path, href: path, page: path })),
  },
  {
    // Tools (SEO_PLAYBOOK.md §11): the hub + the photo checker, palm map and quiz; only live pages are linked.
    title: dict.footer.groups.tools,
    links: ['/tools/', '/tools/palm-photo-checker/', '/tools/palm-map/', '/tools/palm-reading-quiz/']
      .map((path) => localizePath(path, locale))
      .map((path) => ({ label: findPage(path)?.label ?? path, href: path, page: path })),
  },
  {
    title: dict.footer.groups.app,
    links: [{ label: dict.footer.appPage, href: localizePath('/app/', locale), page: localizePath('/app/', locale) }],
  },
  {
    title: dict.footer.groups.legal,
    links: [
      { label: dict.footer.privacy, href: '/privacy.html', page: '/privacy', lang: 'en' },
      { label: dict.footer.terms, href: '/terms.html', page: '/terms', lang: 'en' },
      { label: dict.footer.deleteAccount, href: '/delete-account.html', page: '/delete-account', lang: 'en' },
    ],
  },
]
  .map((group) => ({ ...group, links: group.links.filter((link) => isLive(link.page)) }))
  .filter((group) => group.links.length > 0);
const company = site.company;
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Logo />
      <p class="text-small text-fg-muted measure">{dict.footer.honesty}</p>
    </div>

    <nav aria-label={dict.a11y.footerNav} class="footer-links">
      {
        groups.map((group) => (
          <div>
            <h2 class="footer-heading text-small">{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a class="nav-link footer-link" href={link.href} hreflang={link.lang && link.lang !== locale ? link.lang : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <div class="footer-app">
      <StoreButton locale={locale} medium="footer" campaign="footer" />
    </div>

    <div class="footer-meta text-small text-fg-muted">
      <ul>
        {site.cookieFree && <li>{dict.footer.noCookies}</li>}
        <li>{dict.footer.noSelling}</li>
        <li>{dict.footer.age(site.ageRule)}</li>
        <li>{dict.footer.madeIn}</li>
      </ul>
      {
        company.name && (
          <ul class="footer-company">
            <li>{company.name}</li>
            {company.email && (
              <li>
                {dict.footer.contact}: <a class="text-link" href={`mailto:${company.email}`}>{company.email}</a>
              </li>
            )}
            {company.grievanceContact && (
              <li>
                {dict.footer.grievance}: {company.grievanceContact}
              </li>
            )}
          </ul>
        )
      }
      <p>© {year} {site.brand}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background-color: var(--surface-1); border-top: 1px solid var(--edge); padding-block: 3rem calc(2rem + env(safe-area-inset-bottom)); }
  .footer-grid { display: grid; gap: 2.5rem; }
  .footer-brand { display: flex; flex-direction: column; gap: 1rem; }
  .footer-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1.5rem; }
  .footer-heading { margin: 0 0 0.25rem; font-weight: 700; color: var(--fg); }
  .footer-links ul, .footer-meta ul { list-style: none; margin: 0; padding: 0; }
  .footer-link { display: inline-flex; align-items: center; min-height: 3rem; }
  .footer-meta { display: flex; flex-direction: column; gap: 0.75rem; }
  .footer-meta li { padding-block: 0.125rem; }
  @media (min-width: 64rem) {
    .footer-grid { grid-template-columns: 1.2fr 1.5fr 1fr; align-items: start; }
    .footer-meta { grid-column: 1 / -1; flex-direction: row; flex-wrap: wrap; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 1.5rem; }
    .footer-meta ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  }
</style>
