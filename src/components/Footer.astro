---
/**
 * Site footer (DESIGN_SYSTEM.md §7.11, redesigned WEB-DEC-044). Three layers:
 * a brand stage (mark, the honesty line as a statement, trust chips), the link
 * groups (glass disclosure rows on phones so the page doesn't end in a long
 * list; open columns from 64rem, opened by src/scripts/site.ts), and a base row
 * (credit, company, copyright, back to top) under a large decorative wordmark.
 * Links only to live pages; the company block appears only once the owner's
 * details are in site.ts. No store button here: every page already ends with
 * its own app block. The mobile gold bar hides while the footer is on screen.
 */
import { findPage, isLive, localizedLink } from '../config/pages';
import { site, type Locale } from '../config/site';
import { localizePath, t } from '../i18n';
import Icon, { type IconName } from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  /** Credit for a photo used on this page (e.g. the home hero's Pexels photo). */
  photoCredit?: string | undefined;
}

const { locale, photoCredit } = Astro.props;
const dict = t(locale);
const home = localizePath('/', locale);
const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  page: string;
  /** Language of the target when it differs (the legal pages are English). */
  lang?: string;
  /** Language of the label text when it is English on a Hindi page (registry labels). */
  labelLang?: string;
}

// Guides and tools: the Hindi twin when live, else the English page (lang 'en'), so Hindi pages keep these groups.
const registryLinks = (paths: string[]): FooterLink[] =>
  paths.flatMap((path) => {
    const link = localizedLink(path, locale, localizePath);
    return link ? [{ label: findPage(link.href)?.label ?? link.href, href: link.href, page: link.href, ...(link.lang ? { lang: link.lang } : {}), ...(locale !== 'en' ? { labelLang: 'en' } : {}) }] : [];
  });

const groups: { title: string; links: FooterLink[] }[] = [
  {
    // Guides: labels come from the page registry.
    title: dict.footer.groups.guides,
    links: registryLinks(['/palm-reading/', '/hand-lines/', '/heart-line/', '/head-line/', '/life-line/', '/fate-line/', '/which-hand-to-read/', '/is-palmistry-real/', '/palmistry-terms/']),
  },
  {
    // Tools (SEO_PLAYBOOK.md §11): the hub + the photo checker, palm map and quiz.
    title: dict.footer.groups.tools,
    links: registryLinks(['/tools/', '/tools/palm-photo-checker/', '/tools/palm-map/', '/tools/palm-reading-quiz/']),
  },
  {
    title: dict.footer.groups.read,
    links: [
      { label: dict.nav.sample, href: `${home}#sample`, page: home },
      { label: dict.nav.howItWorks, href: `${home}#how-it-works`, page: home },
      // The blog (WEB-DEC-057): English only, label from the registry; shown once /blog/ is built.
      ...registryLinks(['/blog/']),
      // Trust pages (WEB-FEAT-035): English only, like the legal pages.
      { label: dict.footer.about, href: '/about/', page: '/about/', lang: 'en' },
      { label: dict.footer.founder, href: '/about/deepak-chauhan/', page: '/about/deepak-chauhan/', lang: 'en' },
      { label: dict.footer.editorialPolicy, href: '/editorial-policy/', page: '/editorial-policy/', lang: 'en' },
    ],
  },
  {
    title: dict.footer.groups.app,
    links: [{ label: dict.footer.appPage, href: localizePath('/app/', locale), page: localizePath('/app/', locale) }],
  },
  {
    title: dict.footer.groups.legal,
    links: [
      { label: dict.footer.privacy, href: '/privacy/', page: '/privacy/', lang: 'en' },
      { label: dict.footer.terms, href: '/terms/', page: '/terms/', lang: 'en' },
      { label: dict.footer.refunds, href: '/refunds/', page: '/refunds/', lang: 'en' },
      { label: dict.footer.deleteAccount, href: '/delete-account/', page: '/delete-account/', lang: 'en' },
    ],
  },
]
  .map((group) => ({ ...group, links: group.links.filter((link) => isLive(link.page)) }))
  .filter((group) => group.links.length > 0);

const trust: { icon: IconName; text: string }[] = [
  ...(site.cookieFree ? [{ icon: 'shield' as IconName, text: dict.footer.noCookies }] : []),
  { icon: 'lock', text: dict.footer.noSelling },
  { icon: 'check', text: dict.footer.age(site.ageRule) },
  { icon: 'globe', text: dict.footer.madeIn },
];
const company = site.company;
---

<footer class="site-footer" data-site-footer>
  <div class="wrap">
    <div class="footer-stage">
      <div class="footer-brand">
        <a href={home} class="footer-logo" aria-label={`${site.brand}: ${dict.nav.home}`}><Logo /></a>
        <p class="footer-statement">{dict.footer.honesty}</p>
      </div>
      <ul class="footer-trust">
        {trust.map((item) => (
          <li class="trust-chip"><Icon name={item.icon} class="trust-icon" /><span>{item.text}</span></li>
        ))}
      </ul>
    </div>

    <nav aria-label={dict.a11y.footerNav} class="footer-links">
      {
        groups.map((group) => (
          <details class="footer-group" data-footer-group>
            <summary class="footer-heading">
              <span>{group.title}</span>
              <Icon name="chevron" class="group-chevron" />
            </summary>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a class="footer-link" href={link.href} hreflang={link.lang && link.lang !== locale ? link.lang : undefined}>
                    <span lang={link.labelLang}>{link.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>

    <div class="footer-base text-fg-muted">
      <div class="footer-notes">
        {photoCredit && <p class="footer-credit">{photoCredit}</p>}
        {
          company.name && (
            <ul class="footer-company">
              <li>{`${dict.footer.operatedBy} ${company.name}${company.location ? `, ${company.location}` : ''}`}</li>
              {company.email && (
                <li>
                  {dict.footer.contact}: <a class="text-link" href={`mailto:${company.email}`}>{company.email}</a>
                </li>
              )}
              {company.grievanceContact && (
                <li>
                  {`${dict.footer.grievance}: ${company.grievanceOfficer ?? company.name}${company.email ? ` (${company.email})` : ''}`}
                </li>
              )}
            </ul>
          )
        }
        <p class="footer-copy">© {year} {site.brand}</p>
      </div>
      <a class="btn btn-secondary to-top" href="#main">
        <Icon name="chevron" class="to-top-icon" />
        <span>{dict.footer.toTop}</span>
      </a>
    </div>
  </div>
  <p class="footer-wordmark" aria-hidden="true">{site.brand}</p>
</footer>

<style>
  /* Showroom footer (WEB-DEC-044): brand stage, glass link rows, a lit gold horizon and a large wordmark. */
  .site-footer {
    position: relative; overflow: hidden; margin-top: 2rem; padding-block: 4.5rem 0;
    background:
      linear-gradient(180deg, rgba(30,24,78,0), rgba(30,24,78,0.5));
  }
  .site-footer::before {
    content: ""; position: absolute; inset: 0 0 auto; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.14) 25%, rgba(230,184,92,0.75) 50%, rgba(255,255,255,0.14) 75%, transparent);
    box-shadow: none;
  }
  :global([data-theme="day"]) .site-footer {
    background: linear-gradient(180deg, rgba(255,255,255,0), rgba(255,255,255,0.85));
  }

  /* 1. Brand stage */
  .footer-stage { display: grid; gap: 1.75rem; padding-bottom: 2.5rem; }
  .footer-brand { display: flex; flex-direction: column; gap: 1.25rem; }
  .footer-logo { display: inline-flex; align-self: flex-start; min-height: 3rem; align-items: center; color: var(--fg); text-decoration: none; }
  .footer-logo :global(svg) { height: 2.25rem; width: auto; }
  .footer-statement {
    margin: 0; max-width: 30ch; font-family: var(--ff-display); font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.25rem); line-height: 1.25;
    font-weight: 500; color: var(--fg); text-wrap: balance;
  }
  :lang(hi) .footer-statement { line-height: 1.6; font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem); }
  .footer-trust { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .trust-chip {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.875rem; border-radius: 9999px;
    border: 1px solid transparent; font-size: var(--fs-caption); line-height: 1.35; color: var(--fg-muted);
    background: var(--glass-base) padding-box, var(--rim) border-box;
    box-shadow: var(--shine);
  }
  .trust-chip :global(.trust-icon) { width: 1rem; height: 1rem; flex: none; color: var(--accent); }

  /* 2. Link groups: glass disclosure rows on phones, open columns on desktop. */
  .footer-links { display: grid; gap: 0.625rem; padding-block: 0.5rem 2.5rem; }
  .footer-group {
    border-radius: 1.125rem; border: 1px solid transparent;
    background: linear-gradient(165deg, rgba(64,56,132,0.28), rgba(12,10,34,0.4)) padding-box, var(--glass-base) padding-box, var(--rim) border-box;
    box-shadow: var(--shine);
  }
  :global([data-theme="day"]) .footer-group { background: linear-gradient(165deg, var(--color-white), var(--color-day-surface)) padding-box, var(--rim) border-box; }
  .footer-heading {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; padding: 0 1.125rem;
    list-style: none; cursor: pointer; font-family: var(--ff-sans); font-size: var(--fs-small); font-weight: 700; letter-spacing: 0.02em; color: var(--fg);
  }
  .footer-heading::-webkit-details-marker { display: none; }
  .footer-heading :global(.group-chevron) {
    width: 1.125rem; height: 1.125rem; color: var(--accent); transform: rotate(90deg); transition: transform 300ms var(--ease-out);
  }
  .footer-group[open] .footer-heading :global(.group-chevron) { transform: rotate(-90deg); }
  .footer-group ul { list-style: none; margin: 0; padding: 0 1.125rem 0.75rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; }
  .footer-link {
    display: inline-flex; align-items: center; min-height: 3rem; color: var(--fg-muted); font-size: var(--fs-small); line-height: 1.35; text-decoration: none;
    transition: color 200ms var(--ease), transform 300ms var(--ease-out);
  }
  .footer-link:hover, .footer-link:focus-visible { color: var(--accent); transform: translateX(3px); }

  /* 3. Base row */
  .footer-base {
    position: relative; z-index: 1; display: flex; flex-direction: column; gap: 1.25rem; align-items: flex-start;
    padding-block: 1.5rem 1rem; border-top: 1px solid var(--gc-edge); font-size: var(--fs-caption);
  }
  .footer-notes { display: flex; flex-direction: column; gap: 0.5rem; }
  .footer-notes p { margin: 0; }
  .footer-company { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .footer-credit, .footer-copy { color: var(--fg-faint); }
  .to-top { min-height: 3rem; padding-inline: 1.125rem; font-size: var(--fs-small); }
  .to-top :global(.to-top-icon) { width: 1rem; height: 1rem; transform: rotate(-90deg); }

  /* The wordmark: a big, faint gold brand line that the page ends on. */
  .footer-wordmark {
    margin: -0.5rem 0 0; padding-bottom: calc(1rem + env(safe-area-inset-bottom)); text-align: center; white-space: nowrap; user-select: none; pointer-events: none;
    font-family: "Cormorant Garamond", "Cormorant Fallback", Georgia, serif; font-weight: 700; line-height: 0.8; letter-spacing: -0.03em;
    font-size: clamp(5rem, 22vw, 17rem);
    background: linear-gradient(180deg, rgba(245,217,139,0.34), rgba(230,184,92,0.04) 85%); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  :global([data-theme="day"]) .footer-wordmark { background: linear-gradient(180deg, rgba(122,82,0,0.22), rgba(122,82,0,0.02) 85%); -webkit-background-clip: text; background-clip: text; }

  @media (min-width: 64rem) {
    .site-footer { padding-top: 6rem; }
    .footer-stage { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; column-gap: 4rem; padding-bottom: 3.5rem; }
    .footer-trust { justify-content: flex-end; }
    .footer-links { grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr)); gap: 1rem; padding-bottom: 3.5rem; }
    .footer-group { background: none; border: none; box-shadow: none; }
    :global([data-theme="day"]) .footer-group { background: none; }
    .footer-heading { min-height: 2.5rem; padding: 0; cursor: default; pointer-events: none; font-size: var(--fs-caption); letter-spacing: 0.08em; color: var(--accent); }
    .footer-heading :global(.group-chevron) { display: none; }
    .footer-group ul { padding: 0; grid-template-columns: 1fr; }
    .footer-group:first-child ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; }
    .footer-link { min-height: 2.5rem; }
    .footer-base { flex-direction: row; align-items: center; justify-content: space-between; }
    .footer-notes { flex-direction: row; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: center; }
  }
</style>

