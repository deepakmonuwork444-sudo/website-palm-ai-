---
/**
 * Visible breadcrumbs + BreadcrumbList JSON-LD (DESIGN_SYSTEM.md §7.8).
 * Logical, not taken from the URL. 48px-tall tappable rows.
 */
import { breadcrumbSchema, type Crumb } from '../lib/schema';
import JsonLd from './JsonLd.astro';

interface Props {
  items: Crumb[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label} class="crumbs text-small">
  <ol>
    {
      items.map((item, index) =>
        index === items.length - 1 ? (
          <li><span aria-current="page" class="crumb-current">{item.name}</span></li>
        ) : (
          <li>
            <a class="nav-link crumb-link" href={item.path}>{item.name}</a>
            <span class="crumb-sep" aria-hidden="true">/</span>
          </li>
        ),
      )
    }
  </ol>
</nav>
<JsonLd data={breadcrumbSchema(items)} />

<style>
  /* Showroom: a small glass trail. Rows stay 48px tall for touch. */
  .crumbs { display: flex; }
  .crumbs ol {
    display: inline-flex; flex-wrap: nowrap; align-items: center; list-style: none; margin: 0; padding: 0 1rem;
    max-width: 100%; overflow-x: auto; scrollbar-width: none; white-space: nowrap; overscroll-behavior-x: contain;
    color: var(--fg-muted); border-radius: 0.5rem; border: 1px solid transparent;
    background: var(--glass-1) padding-box, var(--rim) border-box;
    box-shadow: 0 10px 24px -16px rgba(0,0,0,0.6);
  }
  :global([data-theme="day"]) .crumbs ol {
    background: linear-gradient(180deg, var(--color-white), rgba(246,243,253,0.9)) padding-box, var(--rim) border-box;
    box-shadow: 0 8px 20px -14px rgba(23,19,61,0.22);
  }
  .crumbs ol::-webkit-scrollbar { display: none; }
  .crumbs li { display: inline-flex; align-items: center; flex: none; }
  .crumb-link, .crumb-current { display: inline-flex; align-items: center; min-height: 3rem; }
  .crumb-link { color: var(--fg-muted); transition: color 200ms var(--ease); }
  .crumb-link:hover, .crumb-link:focus-visible { color: var(--accent); }
  .crumb-current { color: var(--fg); font-weight: 600; }
  /* The trail scrolls sideways if it must, so keep the focus ring inside it. */
  .crumb-link:focus-visible { outline-offset: -3px; border-radius: 0.5rem; }
  @media (max-width: 30rem) { .crumbs { font-size: var(--fs-caption); } .crumbs ol { padding-inline: 0.875rem; } }
  /* The "/" stays in the HTML (aria-hidden); it shows as a small gold chevron. */
  .crumb-sep { display: inline-flex; align-items: center; justify-content: center; width: 1.375rem; font-size: 0; }
  .crumb-sep::before {
    content: ""; width: 0.375rem; height: 0.375rem; border-top: 1.5px solid var(--accent); border-right: 1.5px solid var(--accent);
    transform: rotate(45deg); opacity: 0.7;
  }
</style>
