---
/**
 * Home v4 opening: the hand scroll story (DESIGN_V4_BRIEF.md "Hero change").
 * One hand in focus at a time. As the visitor scrolls, each hand sharpens,
 * holds while its beat is read, then blurs away as the next one arrives; the
 * last beat is a gold outline of a hand (the camera guide) and the scan button.
 *
 * The hands are AI-generated pictures: decorative only (alt=""), never shown as
 * a reading, and named as AI pictures in the footer credit. Every beat's text
 * is plain HTML in normal flow on every device (Google indexes the phone view);
 * only the picture effect adapts in src/scripts/hand-story.ts: blur on capable
 * devices, a plain fade in lite mode and for reduced motion. Without scripts the
 * first hand stays on screen and all text still reads top to bottom.
 */
import '@fontsource/cormorant-garamond/latin-700-italic.css';
import Icon from '../Icon.astro';
import { site, type Locale } from '../../config/site';
import { t } from '../../i18n';
import { webScanOpen } from '../../lib/reading/open';

interface Props {
  locale: Locale;
  readingHref: string;
}

const { locale, readingHref } = Astro.props;
const dict = t(locale);
const home = dict.home;
const story = home.story;
const { guest, afterEmail } = site.freeReadings;
// Words match the destination: the web scan when it can be finished, else the app (readingHref points there).
const facts = webScanOpen ? home.scan.facts(guest + afterEmail) : home.scan.factsApp(guest + afterEmail);
const ctaLabel = webScanOpen ? home.scan.cta : home.scan.ctaApp;

const hands = [1, 2, 3, 4].map((n) => `/images/story/hand-${n}`);
const widths = [480, 800, 1200];
const srcset = (base: string, ext: string) => widths.map((w) => `${base}-${w}.${ext} ${w}w`).join(', ');
const sizes = '(min-width: 64rem) 40vw, 80vw';
const beatCount = hands.length + 1;
const numbers = locale === 'hi' ? ['०१', '०२', '०३', '०४', '०५'] : ['01', '02', '03', '04', '05'];
---

<section class="story" data-theme="night" data-story aria-labelledby="hero-title">
  <!-- The track spans exactly the story, so the pinned stage ends with it and never covers the next section. -->
  <div class="story-track" aria-hidden="true">
  <div class="story-stage">
    <div class="stage-hands">
      <div class="stage-glow"></div>
      {
        hands.map((base, index) => (
          <picture class="stage-hand" data-hand={index}>
            <source type="image/avif" srcset={srcset(base, 'avif')} sizes={sizes} />
            <img
              src={`${base}-800.webp`}
              srcset={srcset(base, 'webp')}
              sizes={sizes}
              alt=""
              width="800"
              height="993"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'low'}
              decoding="async"
            />
          </picture>
        ))
      }
      <div class="stage-hand stage-guide" data-hand={hands.length}>
        <span class="corner corner-tl"></span>
        <span class="corner corner-tr"></span>
        <span class="corner corner-bl"></span>
        <span class="corner corner-br"></span>
        <span class="guide-hand">
          <img src="/images/story/guide-hand.webp" alt="" width="539" height="790" loading="lazy" decoding="async" />
          <span class="guide-beam"></span>
        </span>
      </div>
    </div>
    <ol class="story-dots">
      {Array.from({ length: beatCount }, (_, index) => <li data-dot={index} data-on={index === 0 ? '' : undefined} />)}
    </ol>
  </div>
  </div>

  <div class="story-beats">
    <div class="beat beat-hero" data-beat="0">
      <h1 id="hero-title" class="beat-heading">
        <span class="beat-label">{story.eyebrow}</span>{' '}
        <span class="beat-title beat-title-xl font-display tracking-display-en">
          {story.title.before} <em>{story.title.em}</em> {story.title.after}
        </span>
      </h1>
      <p class="beat-body">{home.lead}</p>
      <div class="beat-action">
        <a class="btn btn-gold btn-lg story-cta" href={readingHref} data-scan-cta data-hero-cta>
          <Icon name="camera" class="cta-icon" />
          <span>{ctaLabel}</span>
        </a>
        <p class="beat-facts text-small">{facts}</p>
        <p class="beat-saved text-small" data-saved data-one={home.scan.saved(1)} data-many={home.scan.saved(2).replace('2', '{n}')} hidden>
          <span data-saved-text></span>
          <a class="text-link" href={readingHref}>{home.scan.savedLink}</a>
        </p>
      </div>
      <span class="scroll-hint" aria-hidden="true"></span>
    </div>

    {
      story.beats.map((beat, index) => (
        <div class="beat" data-beat={index + 1}>
          <p class="beat-label">
            <span class="beat-num" aria-hidden="true">{numbers[index + 1]}</span>
            {beat.label}
          </p>
          <h2 class="beat-title font-display tracking-display-en">
            {beat.title.before} <em>{beat.title.em}</em>
            {beat.title.after && ` ${beat.title.after}`}
          </h2>
          <p class="beat-body">{beat.body}</p>
        </div>
      ))
    }

    <div class="beat beat-yours" data-beat={hands.length}>
      <p class="beat-label">
        <span class="beat-num" aria-hidden="true">{numbers[hands.length]}</span>
        {story.yours.label}
      </p>
      <h2 class="beat-title beat-title-xl font-display tracking-display-en">
        {story.yours.title.before} <em>{story.yours.title.em}</em>
        {story.yours.title.after && ` ${story.yours.title.after}`}
      </h2>
      <p class="beat-body">{story.yours.body}</p>
      <div class="beat-action">
        <a class="btn btn-gold btn-lg story-cta" href={readingHref} data-scan-cta>
          <Icon name="camera" class="cta-icon" />
          <span>{ctaLabel}</span>
        </a>
        <p class="beat-facts text-small">
          {facts}{' '}
          <a class="text-link" href="/privacy/#website" hreflang={locale === 'hi' ? 'en' : undefined}>{story.yours.photoLink}</a>
        </p>
        <p class="beat-honesty text-caption">{home.scan.honesty}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hand-story.ts';
</script>

<style>
  .story {
    isolation: isolate;
    --story-top: 3.5rem;
    --stage-h: calc(100svh - var(--story-top));
    /* The picture takes the top of the screen; the words (about 22rem) always fit under it. */
    --hand-h: max(11rem, min(calc(var(--stage-h) * 0.46), calc(var(--stage-h) - 22rem)));
    position: relative;
    background-color: var(--page);
    /* Room light for the opening: a violet wash from the top left, a warm floor glow at the bottom. */
    background-image:
      radial-gradient(56rem 36rem at 0% 0%, rgba(98, 72, 214, 0.26), transparent 65%),
      radial-gradient(40rem 30rem at 100% 100%, rgba(230, 184, 92, 0.08), transparent 70%);
    background-repeat: no-repeat;
    color: var(--fg);
  }

  /* ---------- the sticky picture stage ---------- */
  .story-track { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .story-stage { position: sticky; top: var(--story-top); height: var(--stage-h); overflow: hidden; }
  .stage-hands { position: absolute; inset: 0.5rem 0 auto; height: var(--hand-h); }
  .stage-glow {
    position: absolute; left: 50%; top: 50%; width: 150%; aspect-ratio: 1; translate: -50% -50%;
    max-width: 44rem;
    border-radius: 50%;
    /* A layered halo: warm core, violet body, a faint cool rim of light. */
    background:
      radial-gradient(circle, rgba(255, 226, 160, 0.26) 0%, rgba(230, 184, 92, 0.1) 26%, transparent 44%),
      radial-gradient(circle, transparent 38%, rgba(98, 72, 214, 0.34) 50%, rgba(46, 34, 120, 0.2) 60%, transparent 70%),
      radial-gradient(circle, rgba(27, 21, 69, 0.55) 30%, rgba(11, 10, 31, 0) 70%);
  }
  /* A thin ring of light around the hand, like a lit display niche. */
  .stage-glow::before {
    content: ""; position: absolute; inset: 21%; border-radius: 50%;
    border: 1px solid rgba(245, 217, 139, 0.16);
    box-shadow: 0 0 2.5rem rgba(245, 217, 139, 0.08), inset 0 0 3rem rgba(245, 217, 139, 0.06);
  }
  /* The warm pool the hand rests over. */
  .stage-glow::after {
    content: ""; position: absolute; left: 22%; right: 22%; top: 84%; height: 9%; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(245, 217, 139, 0.22), rgba(98, 72, 214, 0.14) 60%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-lite])) .stage-glow::before { animation: halo-breathe 6s var(--ease) infinite alternate; }
  }
  @keyframes halo-breathe { from { opacity: 0.55; scale: 0.985; } to { opacity: 1; scale: 1.015; } }
  .stage-hand {
    position: absolute; left: 50%; top: 0; height: 100%; aspect-ratio: 800 / 993; max-width: 92vw;
    translate: -50% 0; opacity: 0; visibility: hidden;
  }
  .stage-hand[data-hand="0"] { opacity: 1; visibility: visible; }
  .stage-hand img {
    display: block; width: 100%; height: 100%; object-fit: contain;
    /* Soft edges into the page. A mask reads only alpha: "black" here means opaque, not a colour. */
    -webkit-mask-image: radial-gradient(ellipse 50% 50% at 50% 45%, black 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 50% 50% at 50% 45%, black 58%, transparent 100%);
  }

  /* The last beat: a gold outline of a real hand shape, framed like a camera guide. */
  .stage-guide { aspect-ratio: 440 / 600; }
  .corner { position: absolute; width: 11%; aspect-ratio: 1; border: 0 solid rgba(245, 217, 139, 0.7); }
  .corner-tl { left: 0; top: 0; border-width: 2px 0 0 2px; border-top-left-radius: 0.875rem; }
  .corner-tr { right: 0; top: 0; border-width: 2px 2px 0 0; border-top-right-radius: 0.875rem; }
  .corner-bl { left: 0; bottom: 0; border-width: 0 0 2px 2px; border-bottom-left-radius: 0.875rem; }
  .corner-br { right: 0; bottom: 0; border-width: 0 2px 2px 0; border-bottom-right-radius: 0.875rem; }
  .guide-hand { position: absolute; left: 50%; top: 11%; height: 80%; aspect-ratio: 539 / 790; translate: -50% 0; }
  .guide-hand img {
    display: block; width: 100%; height: 100%;
    filter: drop-shadow(0 0 1rem rgba(245, 217, 139, 0.5));
    -webkit-mask-image: none; mask-image: none;
  }
  .guide-beam {
    position: absolute; inset: 0;
    -webkit-mask: url('/images/story/guide-hand.webp') center / 100% 100% no-repeat;
    mask: url('/images/story/guide-hand.webp') center / 100% 100% no-repeat;
    background:
      linear-gradient(90deg, rgba(245, 217, 139, 0) 12%, var(--color-gold-bright) 50%, rgba(245, 217, 139, 0) 88%) 0 var(--beam-y, 60%) / 100% 3px no-repeat,
      linear-gradient(180deg, rgba(245, 217, 139, 0) 0%, rgba(245, 217, 139, 0.2) 100%) 0 calc(var(--beam-y, 60%) - 2.5rem) / 100% 2.5rem no-repeat;
    animation: guide-beam 3.2s var(--ease) infinite alternate;
  }
  @property --beam-y { syntax: '<percentage>'; inherits: false; initial-value: 60%; }
  @keyframes guide-beam { from { --beam-y: 38%; } to { --beam-y: 76%; } }

  .story-dots {
    display: none; position: absolute; left: 50%; top: calc(var(--hand-h) + 1.25rem); translate: -50% 0;
    gap: 0.5rem; margin: 0; padding: 0; list-style: none;
  }
  .story-dots li { width: 0.3125rem; height: 0.3125rem; border-radius: 9999px; background-color: var(--border-strong); transition: width var(--dur-normal) var(--ease), background-color var(--dur-normal) var(--ease); }
  .story-dots li[data-on] { width: 1.375rem; background-color: var(--accent); }

  /* ---------- the beats (normal flow; text sits under the picture) ---------- */
  .story-beats { position: relative; z-index: 1; }
  /* Phones and tablets: a beat's words fade as they scroll up into the picture (hand-story.ts); a focused link always shows. */
  .beat:focus-within { opacity: 1 !important; }
  .beat {
    position: relative;
    min-height: var(--stage-h);
    display: flex; flex-direction: column; justify-content: flex-start; gap: 0.75rem;
    padding: calc(var(--hand-h) + 2.5rem) var(--gutter) 2.5rem;
    /* Words pass over a fading picture between beats: a soft shadow keeps them readable. */
    text-shadow: 0 1px 0.75rem rgba(11, 10, 31, 0.9), 0 0 2rem rgba(11, 10, 31, 0.7);
  }
  .beat .btn { text-shadow: none; }
  .beat-heading { margin: 0; display: flex; flex-direction: column; gap: 0.625rem; }
  .beat-label {
    margin: 0; display: flex; align-items: baseline; gap: 0.625rem;
    font-size: var(--fs-small); font-weight: 700; color: var(--accent); letter-spacing: 0.04em;
  }
  /* A short gold rule leads each label. */
  .beat-label::before {
    content: ""; flex: none; align-self: center; width: 1.75rem; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent)); box-shadow: 0 0 8px rgba(230, 184, 92, 0.6);
  }
  .beat-num { color: var(--fg-muted); font-variant-numeric: tabular-nums; }
  .beat-title { margin: 0; font-size: var(--fs-h1); line-height: var(--lh-h1); font-weight: 700; color: var(--fg); }
  .beat-title-xl { font-size: var(--fs-display); line-height: var(--lh-display); }
  /* The key word in gold foil (colour comes from the shared foil rule); room so the italic's tail is not clipped. */
  .beat-title em { font-style: italic; padding-inline-end: 0.08em; margin-inline-end: -0.08em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  :lang(hi) .beat-title em { font-style: normal; padding-block: 0.14em; }
  .beat-body { margin: 0; max-width: 34rem; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--fg-muted); }
  .beat-action { display: flex; flex-direction: column; align-items: stretch; gap: 0.5rem; margin-top: 0.5rem; }
  .story-cta { width: 100%; }
  .story-cta :global(.cta-icon) { width: 1.35rem; height: 1.35rem; }
  .beat-facts { margin: 0; text-align: center; color: var(--fg); }
  .beat-saved { margin: 0; text-align: center; color: var(--fg-muted); }
  .beat-saved[hidden] { display: none; }
  .beat-saved a { margin-inline-start: 0.375rem; }
  .beat-honesty { margin: 0.25rem 0 0; text-align: center; color: var(--fg-muted); }
  .scroll-hint { display: none; }

  :lang(hi) .story { --hand-h: max(11rem, min(calc(var(--stage-h) * 0.46), calc(var(--stage-h) - 25rem))); }
  @media (min-width: 48rem) {
    .story { --hand-h: max(14rem, min(calc(var(--stage-h) * 0.5), calc(var(--stage-h) - 22rem))); }
    .beat { align-items: center; text-align: center; }
    .beat-label { justify-content: center; }
    .beat-action { align-items: center; }
    .story-cta { width: auto; padding-inline: 2.25rem; }
  }

  /* ---------- desktop: words on the left, the picture stage on the right ---------- */
  @media (min-width: 64rem) {
    .story { --story-top: 4rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .story { --stage-h: calc(100vh - var(--story-top)); }
    .story-track { position: relative; inset: auto; grid-column: 2; grid-row: 1; }
    .stage-hands { inset: 5% 0; height: auto; }
    .story-dots { display: flex; left: auto; right: max(1.5rem, calc((100vw - 80rem) / 2)); top: 50%; translate: 0 -50%; flex-direction: column; }
    .story-dots li[data-on] { width: 0.3125rem; height: 1.625rem; }
    .story-beats { grid-column: 1; grid-row: 1; }
    .beat {
      justify-content: center; align-items: flex-start; text-align: start; gap: 1.25rem; text-shadow: none;
      padding: 4rem var(--gutter) 4rem max(var(--gutter), calc((100vw - 80rem) / 2 + var(--gutter)));
    }
    .beat-label { justify-content: flex-start; }
    .beat-title { font-size: clamp(2.75rem, 1.5rem + 2.6vw, 4.75rem); line-height: 1.02; }
    .beat-title-xl { font-size: clamp(3.25rem, 1.5rem + 3.4vw, 5.75rem); line-height: 0.98; }
    :lang(hi) .beat-title, :lang(hi) .beat-title-xl { line-height: 1.35; }
    .beat-action { align-items: flex-start; }
    .beat-facts, .beat-saved, .beat-honesty { text-align: start; }
    .scroll-hint {
      display: block; position: absolute; bottom: 2.5rem; width: 1px; height: 2.5rem;
      background: linear-gradient(180deg, transparent, var(--accent));
    }
  }
</style>
