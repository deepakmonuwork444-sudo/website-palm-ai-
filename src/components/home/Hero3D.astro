---
/**
 * Home opening (replaces the scroll-pinned HandStory): one normal hero section.
 * Phone: the hand on a lit stage, then the headline, lead, the gold scan
 * button and its note. Desktop: words on the left, the hand on the right.
 * Same words everywhere (Google indexes the phone view); no scroll pinning.
 *
 * The hand: a poster image first (the LCP, and all that low-end devices,
 * Save-Data, 2G and no-WebGL visitors ever see), then a live three.js hand
 * that fades in over it once loaded (src/scripts/hero-3d.ts). It can be
 * turned with a finger or the mouse. The hand is an AI-generated 3D model,
 * decorative only (alt="", canvas aria-hidden); the footer credit says so.
 */
import '@fontsource/cormorant-garamond/latin-700-italic.css';
import Icon from '../Icon.astro';
import { site, type Locale } from '../../config/site';
import { t } from '../../i18n';
import { webScanOpen } from '../../lib/reading/open';

interface Props {
  locale: Locale;
  readingHref: string;
}

const { locale, readingHref } = Astro.props;
const home = t(locale).home;
const story = home.story;
const { guest, afterEmail } = site.freeReadings;
// Words match the destination: the web scan when it can be finished, else the app (readingHref points there).
const facts = webScanOpen ? home.scan.facts(guest + afterEmail) : home.scan.factsApp(guest + afterEmail);
const ctaLabel = webScanOpen ? home.scan.cta : home.scan.ctaApp;

const poster = '/images/hero/hand-v1';
const widths = [600, 900, 1200];
const srcset = (ext: string) => widths.map((w) => `${poster}-${w}.${ext} ${w}w`).join(', ');
const sizes = '(min-width: 64rem) 44rem, min(100vw, 24rem)';
---

<section class="h3" data-theme="night" data-no-reveal aria-labelledby="hero-title">
  <div class="h3-inner">
    <div class="h3-stage" data-hero3d aria-hidden="true">
      <div class="h3-halo"></div>
      <div class="h3-frame" data-hero3d-frame>
        <picture>
          <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
          <img
            class="h3-poster"
            src={`${poster}-900.webp`}
            srcset={srcset('webp')}
            sizes={sizes}
            alt=""
            width="1200"
            height="1200"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <span class="h3-hint">
        <svg viewBox="0 0 48 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 10h36M11 5l-5 5 5 5M37 5l5 5-5 5" />
        </svg>
      </span>
    </div>

    <div class="h3-copy">
      <h1 id="hero-title" class="h3-heading">
        <span class="h3-label">{story.eyebrow}</span><span class="sr-only">:</span>{' '}
        <span class="h3-title font-display tracking-display-en">
          {story.title.before} <em>{story.title.em}</em> {story.title.after}
        </span>
      </h1>
      <p class="h3-lead">{home.lead}</p>
      <div class="h3-action">
        <a class="btn btn-gold btn-lg h3-cta" href={readingHref} data-scan-cta data-hero-cta>
          <Icon name="camera" class="cta-icon" />
          <span>{ctaLabel}</span>
        </a>
        <p class="h3-facts text-small">{facts}</p>
        <p class="h3-saved text-small" data-saved data-one={home.scan.saved(1)} data-many={home.scan.saved(2).replace('2', '{n}')} hidden>
          <span data-saved-text></span>
          <a class="text-link" href={readingHref}>{home.scan.savedLink}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-3d.ts';
</script>

<style>
  .h3 {
    /* The copy block's height on phones; the stage takes what is left of the first screen. */
    --copy: 25.5rem;
    --stage: clamp(15rem, calc(100svh - 4.25rem - var(--copy)), 24rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--fg);
    background-color: var(--page);
    padding-block: 0.5rem 3rem;
  }
  :lang(hi) .h3 { --copy: 28.5rem; }
  /* Day: the dark stage becomes a lit display case set into the light page. */
  :global(html[data-theme="day"]) .h3 {
    margin: 0.25rem 0.625rem 0;
    border-radius: 1rem;
    border: 1px solid var(--border-strong);
    box-shadow: 0 6px 16px -8px rgba(23, 19, 61, 0.4);
  }

  .h3-inner { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; width: 100%; max-width: 80rem; margin-inline: auto; padding-inline: var(--gutter); }

  /* ---------- the stage ---------- */
  .h3-stage { position: relative; display: grid; place-items: center; width: 100%; }
  .h3-frame { position: relative; z-index: 1; width: min(100%, var(--stage)); aspect-ratio: 1; }
  .h3-poster, .h3-frame :global(.h3-canvas) { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .h3-poster { transition: opacity 700ms var(--ease); }
  .h3-frame :global(.h3-canvas) {
    opacity: 0; transition: opacity 700ms var(--ease);
    touch-action: pan-y; cursor: grab; -webkit-tap-highlight-color: transparent; user-select: none;
  }
  .h3-frame :global(.h3-canvas:active) { cursor: grabbing; }
  .h3-stage[data-live] .h3-frame :global(.h3-canvas) { opacity: 1; }
  .h3-stage[data-live] .h3-poster { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .h3-poster, .h3-frame :global(.h3-canvas) { transition: none; }
  }

  /* Natural look (2026-10-02): one thin, still ring behind the hand; no glow, no light pools. */
  .h3-halo {
    position: absolute; left: 50%; top: 50%; width: calc(min(100%, var(--stage)) * 0.72); aspect-ratio: 1; translate: -50% -50%;
    border-radius: 50%; pointer-events: none; border: 1px solid rgba(245, 217, 139, 0.16);
  }

  /* "Drag to turn": a small glass pill, only once the live hand is there, gone after the first touch. */
  .h3-hint {
    position: absolute; z-index: 2; left: 50%; bottom: 0.25rem; translate: -50% 0;
    display: inline-flex; align-items: center; justify-content: center; width: 3.25rem; height: 1.75rem; border-radius: 9999px;
    color: var(--color-gold-bright); opacity: 0; pointer-events: none;
    border: 1px solid transparent;
    background: var(--glass-base) padding-box, var(--rim) border-box;
    transition: opacity 600ms var(--ease) 1.2s;
  }
  .h3-hint svg { width: 1.75rem; height: 0.75rem; }
  .h3-stage[data-live] .h3-hint { opacity: 0.85; }
  .h3-stage:has([data-touched]) .h3-hint { opacity: 0; transition-delay: 0s; }
  @media (prefers-reduced-motion: no-preference) {
    .h3-stage[data-live] .h3-hint svg { animation: h3-nudge 2.8s var(--ease) 2s infinite; }
  }
  @keyframes h3-nudge { 0%, 60%, 100% { translate: 0 0; } 20% { translate: -3px 0; } 40% { translate: 3px 0; } }

  /* ---------- the words ---------- */
  .h3-copy { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.875rem; width: 100%; max-width: 36rem; text-align: center; }
  .h3-heading { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 0.625rem; }
  .h3-label {
    display: flex; align-items: center; gap: 0.625rem;
    font-size: var(--fs-small); font-weight: 700; color: var(--accent); letter-spacing: 0.04em;
  }
  .h3-label::before, .h3-label::after {
    content: ""; flex: none; width: 1.5rem; height: 1px;
    background: var(--accent);
  }
  .h3-title { font-size: var(--fs-display); line-height: var(--lh-display); font-weight: 700; color: var(--fg); }
  /* The key word in solid gold (shared rule); room so the italic's tail is not clipped. */
  .h3-title em { font-style: italic; padding-inline-end: 0.08em; margin-inline-end: -0.08em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  :lang(hi) .h3-title em { font-style: normal; padding-block: 0.14em; }
  .h3-lead { margin: 0; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--fg-muted); text-wrap: pretty; }
  .h3-action { display: flex; flex-direction: column; align-items: stretch; gap: 0.5rem; width: 100%; margin-top: 0.375rem; }
  .h3-cta { width: 100%; min-height: 3.5rem; }
  .h3-cta :global(.cta-icon) { width: 1.35rem; height: 1.35rem; }
  .h3-facts { margin: 0; color: var(--fg); }
  .h3-saved { margin: 0; color: var(--fg-muted); }
  .h3-saved[hidden] { display: none; }
  .h3-saved a { margin-inline-start: 0.375rem; }

  @media (min-width: 48rem) {
    .h3 { --stage: clamp(18rem, calc(100svh - 4.25rem - var(--copy)), 28rem); }
    .h3-cta { width: auto; padding-inline: 2.25rem; }
    .h3-action { align-items: center; }
  }

  /* ---------- desktop: words on the left, the hand on the right ---------- */
  @media (min-width: 64rem) {
    .h3 {
      --stage: clamp(28rem, calc(100svh - 7rem), 44rem);
      display: grid; align-items: center; min-height: min(calc(100svh - 7rem), 52rem); padding-block: 1rem 2rem;
    }
    :global(html[data-theme="day"]) .h3 { margin-inline: 1rem; border-radius: 1.25rem; }
    .h3-inner {
      display: grid; grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr); align-items: center; gap: 2rem;
      padding-inline: max(var(--gutter), calc((100vw - 76rem) / 2));
    }
    .h3-stage { grid-column: 2; grid-row: 1; }
    .h3-copy { grid-column: 1; grid-row: 1; align-items: flex-start; text-align: start; gap: 1.25rem; max-width: 34rem; }
    .h3-heading { align-items: flex-start; gap: 0.875rem; }
    .h3-label::after { display: none; }
    .h3-title { font-size: clamp(3.25rem, 1.5rem + 3.4vw, 5.75rem); line-height: 0.98; }
    :lang(hi) .h3-title { line-height: 1.35; }
    .h3-action { align-items: flex-start; }
  }
</style>
