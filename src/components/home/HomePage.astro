---
/**
 * Home page, both languages (`/` and `/hi/`). Tool 1 (the free reading) lives
 * here once the web reading is live; until then the page is honest about it
 * (site.webReadingEnabled). Section order follows UX_PSYCHOLOGY.md §3.1:
 * hero → sample (meaning first) → how it works → what's free → the lines → app.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../Chip.astro';
import Icon from '../Icon.astro';
import LockedCard from '../LockedCard.astro';
import PalmTrace, { type LineName } from '../PalmTrace.astro';
import StoreButton from '../StoreButton.astro';
import UploadCard from './UploadCard.astro';
import { isLive } from '../../config/pages';
import { site, type Locale } from '../../config/site';
import { localizePath, t } from '../../i18n';
import { en } from '../../i18n/en';
import { hi } from '../../i18n/hi';
import { organizationSchema, webApplicationSchema, websiteSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const home = dict.home;
const path = localizePath('/', locale);
const live = site.webReadingEnabled;
const title = live ? dict.meta.homeTitleLive : dict.meta.homeTitleSoon;
const description = live ? dict.meta.homeDescriptionLive : dict.meta.homeDescriptionSoon;
const h1 = live ? home.h1Live : home.h1Soon;

const jsonLd = [
  organizationSchema(),
  websiteSchema(locale),
  ...(live ? [webApplicationSchema({ name: h1, path, locale, description })] : []),
];

const appPath = localizePath('/app/', locale);
const lineOrder: LineName[] = ['heart', 'head', 'life', 'fate'];
const guidePath = (line: LineName) => localizePath(`/${line}-line/`, locale);
const stepNumbers = locale === 'hi' ? ['१', '२', '३'] : ['1', '2', '3'];
const parts = home.sample.parts;
const otherDict = locale === 'en' ? hi : en;
---

<BaseLayout title={title} description={description} path={path} locale={locale} jsonLd={jsonLd} headerCta={false}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title" class="font-display text-display tracking-display-en hero-title">{h1}</h1>
      <p class="text-lead text-fg-muted measure hero-lead">{home.lead}</p>
      {!live && <p class="measure hero-soon">{home.leadSoon}</p>}
      <UploadCard locale={locale} />
      <ul class="hero-chips" aria-label={site.brand}>
        <li><Chip variant="promise" locale={locale} icon="shield" text={home.chips.noPayment} /></li>
        <li><Chip variant="promise" locale={locale} icon="globe" text={home.chips.bilingual} /></li>
      </ul>
    </div>
    <div class="hero-art">
      <PalmTrace locale={locale} id="hero-palm" animate caption={dict.palm.diagramCaption} />
    </div>
  </section>

  <section id="sample" class="section" aria-labelledby="sample-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="sample-title" class="text-h2 font-bold">{home.sample.title}</h2>
        <Chip variant="label" locale={locale} text={home.sample.badge} />
      </div>
      <p class="measure text-fg-muted section-intro">{home.sample.intro}</p>

      <div class="sample-grid">
        <div class="sample-figure">
          <PalmTrace locale={locale} id="sample-palm" size="compact" missing={['fate']} alt={dict.palm.sampleAlt} />
          <div class="not-clear">
            <p class="font-bold">{home.sample.notClearTitle}</p>
            <p class="text-small text-fg-muted">{home.sample.notClearBody}</p>
          </div>
        </div>

        <div class="sample-report">
          <div class="glance">
            <h3 class="text-h3 font-bold">{home.sample.glanceTitle}</h3>
            <ul>
              {home.sample.glance.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          {
            [parts.love, parts.personality].map((part) => (
              <article class="part">
                <h3 class="text-h3 font-bold">{part.title}</h3>
                <p class="part-label text-small">{home.sample.sawLabel}</p>
                <p>{part.saw}</p>
                <p class="part-label text-small">{home.sample.saysLabel}</p>
                <p>{part.says}</p>
                <p class="part-source text-small text-fg-muted">{part.source}</p>
              </article>
            ))
          }

          <p class="read-count font-bold">{home.sample.readCount}</p>
          <div class="locked-grid">
            {
              [parts.career, parts.direction].map((part) => (
                <LockedCard
                  title={part.title}
                  firstSentence={part.firstSentence}
                  href={`${appPath}#get`}
                  actionLabel={dict.locked.open}
                  lockedLabel={dict.locked.lockedLabel}
                />
              ))
            }
          </div>
          <p class="text-small text-fg-muted">{home.sample.lockNote}</p>
          <p class="honesty text-small">
            <Icon name="info" class="honesty-icon" />
            <span>{home.sample.honesty}</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section band" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title" class="text-h2 font-bold">{home.how.title}</h2>
      <ol class="steps">
        {
          home.how.steps.map((step, index) => (
            <li class="step">
              <span class="step-num" aria-hidden="true">
                {stepNumbers[index]}
              </span>
              <h3 class="text-h3 font-bold">{step.title}</h3>
              <p class="text-fg-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
      {!live && <p class="soon-note text-small"><Icon name="info" class="honesty-icon" /><span>{home.how.soonNote}</span></p>}
    </div>
  </section>

  <section class="section" aria-labelledby="free-title">
    <div class="wrap">
      <h2 id="free-title" class="text-h2 font-bold">{home.free.title}</h2>
      <div class="free-grid">
        <div class="free-web">
          <h3 class="text-h3 font-bold">{home.free.webTitle}</h3>
          <ul class="ticks">
            {home.free.web.map((item) => <li><Icon name="check" class="tick" /><span>{item}</span></li>)}
          </ul>
          <p class="no-card text-small"><Icon name="shield" class="tick" /><span>{home.free.noCard}</span></p>
        </div>
        <div class="free-app">
          <h3 class="text-h3 font-bold">{home.free.appTitle}</h3>
          <ul class="ticks">
            {home.free.app.map((item) => <li><Icon name="check" class="tick" /><span>{item}</span></li>)}
          </ul>
          <ul class="app-prices text-small" aria-label={dict.store.priceLabel}>
            <li>{dict.store.freeToInstall}</li>
            <li>{dict.store.plansFrom(site.appPrices.planFromPerMonth)}</li>
            <li>{dict.store.packsFrom(site.appPrices.packFrom)}</li>
            <li>{dict.store.cancelAnytime}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="lines-title">
    <div class="wrap">
      <h2 id="lines-title" class="text-h2 font-bold">{home.learn.title}</h2>
      <p class="measure text-fg-muted section-intro">{home.learn.intro}</p>
      <ul class="lines-list">
        {
          lineOrder.map((line) => (
            <li class="line-row">
              <svg class="line-glyph" viewBox="0 0 48 24" aria-hidden="true">
                <path class="glyph-halo" d="M4 18 C 16 6, 30 6, 44 12" />
                <path class:list={['glyph-line', `glyph-${line}`]} d="M4 18 C 16 6, 30 6, 44 12" />
              </svg>
              <div class="line-copy">
                <h3 class="text-h3 font-bold">
                  {dict.lines[line].name}
                  <span
                    class:list={['line-other text-small', { 'script-system': locale === 'en' }]}
                    lang={locale === 'en' ? 'hi' : 'en'}
                  >
                    {otherDict.lines[line].name}
                  </span>
                </h3>
                <p class="text-small text-fg-muted">{dict.lines[line].where}</p>
                <p>{dict.lines[line].reads}</p>
                {isLive(guidePath(line)) && (
                  <a class="text-link" href={guidePath(line)}>
                    {dict.lines.guideLink(dict.lines[line].name)}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="app" class="section" aria-labelledby="app-title">
    <div class="wrap app-grid">
      <div class="app-copy">
        <h2 id="app-title" class="text-h2 font-bold">{home.app.title}</h2>
        <p class="measure">{home.app.body}</p>
        <ul class="ticks">
          {home.free.app.map((item) => <li><Icon name="check" class="tick" /><span>{item}</span></li>)}
        </ul>
        <p class="text-small text-fg-muted">{dict.store.playName(site.appNameOnPlay)}</p>
        <a class="text-link" href={appPath}>{home.card.moreAboutApp}</a>
      </div>
      <StoreButton locale={locale} medium="home" campaign="app_section" showQr />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; gap: 2.5rem; padding-block: 1.5rem 3rem; }
  .hero-copy { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .hero-title { margin: 0; }
  .hero-lead, .hero-soon { margin: 0; }
  .hero-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .hero-art { min-width: 0; }
  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: start; gap: 4rem; padding-block: 3rem 1rem; }
    .hero-art { position: sticky; top: 5rem; }
  }

  .band { background-color: var(--surface-1); border-block: 1px solid var(--edge); }
  .section-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .section-head h2, section h2 { margin: 0; }
  .section-intro { margin: 0.75rem 0 0; }

  .sample-grid { display: grid; gap: 2rem; margin-top: 2rem; }
  .sample-figure { display: flex; flex-direction: column; gap: 1rem; }
  .not-clear { padding: 1rem 1.25rem; border-radius: 1.25rem; border: 1.5px dashed var(--fg-muted); }
  .not-clear p { margin: 0; }
  .not-clear p + p { margin-top: 0.25rem; }
  .sample-report { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
  .glance, .part { padding: 1.25rem; border-radius: 1.25rem; background-color: var(--surface-1); border: 1px solid var(--edge); }
  .glance h3, .part h3 { margin: 0 0 0.5rem; }
  .glance ul { margin: 0; padding-inline-start: 1.25rem; list-style: disc; display: flex; flex-direction: column; gap: 0.375rem; }
  .glance li::marker { color: var(--accent); }
  .part p { margin: 0; }
  .part-label { margin-top: 0.75rem !important; color: var(--accent); font-weight: 700; }
  .part-source { margin-top: 0.75rem !important; }
  .read-count { margin: 0.25rem 0 0; }
  .locked-grid { display: grid; gap: 1rem; }
  .honesty, .soon-note { display: flex; gap: 0.625rem; align-items: flex-start; margin: 0; padding: 1rem 1.25rem; border-radius: 0.75rem;
    background-color: var(--surface-2); color: var(--fg); }
  .honesty :global(.honesty-icon), .soon-note :global(.honesty-icon) { color: var(--accent); margin-top: 0.15rem; }
  @media (min-width: 48rem) {
    .locked-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 64rem) {
    .sample-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 3rem; align-items: start; }
    .sample-figure { position: sticky; top: 5rem; }
  }

  .steps { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  .step { display: flex; flex-direction: column; gap: 0.375rem; }
  .step h3 { margin: 0; }
  .step p { margin: 0; }
  /* Mukta, not Cormorant: Cormorant's old-style 1 reads as "I". */
  .step-num { font-size: var(--fs-h2); font-weight: 700; line-height: 1.2; color: var(--accent); }
  .soon-note { margin-top: 2rem; }
  @media (min-width: 64rem) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; }
  }

  .free-grid { display: grid; gap: 1.25rem; margin-top: 2rem; }
  .free-web, .free-app { padding: 1.5rem; border-radius: 1.25rem; border: 1px solid var(--edge); }
  .free-web { background-color: var(--surface-1); }
  .free-app { background-color: var(--surface-2); }
  .free-web h3, .free-app h3 { margin: 0 0 1rem; }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.625rem; }
  .ticks li, .no-card { display: flex; gap: 0.625rem; align-items: flex-start; }
  .ticks :global(.tick), .no-card :global(.tick) { color: var(--accent); margin-top: 0.2rem; }
  .no-card { margin: 1.25rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border); }
  .app-prices { list-style: none; margin: 1.25rem 0 0; padding: 1rem 0 0; border-top: 1px solid var(--border-strong); display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; color: var(--fg-muted); }
  @media (min-width: 48rem) {
    .free-grid { grid-template-columns: 1fr 1fr; }
  }

  .lines-list { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; gap: 0; }
  .line-row { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding-block: 1.25rem; border-top: 1px solid var(--border); }
  .line-row:last-child { border-bottom: 1px solid var(--border); }
  .line-glyph { width: 3rem; height: 1.5rem; margin-top: 0.35rem; }
  .glyph-halo { fill: none; stroke: var(--color-halo); stroke-width: 6; stroke-linecap: round; }
  .glyph-line { fill: none; stroke-width: 3.5; stroke-linecap: round; }
  .glyph-life { stroke: var(--line-life); }
  .glyph-head { stroke: var(--line-head); }
  .glyph-heart { stroke: var(--line-heart); }
  .glyph-fate { stroke: var(--line-fate); }
  :global([data-theme="day"]) .glyph-halo { display: none; }
  .line-copy h3 { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.625rem; }
  .line-other { color: var(--fg-muted); font-weight: 400; }
  .line-copy p { margin: 0.25rem 0 0; }
  @media (min-width: 64rem) {
    .lines-list { grid-template-columns: 1fr 1fr; column-gap: 3rem; }
    .line-row:nth-last-child(2) { border-bottom: 1px solid var(--border); }
  }

  .app-grid { display: grid; gap: 2rem; }
  .app-copy { display: flex; flex-direction: column; gap: 1rem; }
  .app-copy p { margin: 0; }
  @media (min-width: 64rem) {
    .app-grid { grid-template-columns: 1fr 1fr; align-items: start; gap: 4rem; }
  }
</style>
