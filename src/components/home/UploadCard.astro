---
/**
 * The home hero card (DESIGN_SYSTEM.md §7.3) — the page's one gold hairline.
 *
 * While site.webReadingEnabled is false (server work not deployed), the card is
 * honest: it says the web reading opens soon, the gold action is the sample
 * hand (which works), and "Read my own palm" opens an in-place panel pointing
 * to the Android app. Nothing is uploaded and no reading is ever faked.
 * The live upload UI is WEB-FEAT-020/026: flipping the flag without building
 * it fails the build instead of shipping a dead button.
 */
import { localizePath, t } from '../../i18n';
import { site, type Locale } from '../../config/site';
import Icon from '../Icon.astro';
import PrimaryButton from '../PrimaryButton.astro';
import StoreButton from '../StoreButton.astro';

interface Props {
  locale: Locale;
}

if (site.webReadingEnabled) {
  throw new Error('UploadCard: webReadingEnabled is true, but the live upload UI (WEB-FEAT-020/026) is not built yet.');
}

const { locale } = Astro.props;
const dict = t(locale);
const card = dict.home.card;
---

<div id="read" class="upload-card">
  <h2 class="text-h3 font-bold card-title">{card.title}</h2>
  <p class="card-status">
    <Icon name="info" class="status-icon" />
    <span><strong>{card.status}</strong> {card.statusDetail}</span>
  </p>
  <PrimaryButton href="#sample" block>{dict.nav.trySample}</PrimaryButton>
  <details class="own-palm">
    <summary class="btn btn-secondary btn-block">{card.ownPalm}</summary>
    <div class="own-body">
      <p>{card.ownPalmBody}</p>
      <StoreButton locale={locale} medium="home" campaign="upload_card" />
      <a class="text-link" href={localizePath('/app/', locale)}>{card.moreAboutApp}</a>
    </div>
  </details>
</div>

<style>
  .upload-card {
    display: flex; flex-direction: column; gap: 1rem; padding: 1.25rem; border-radius: 1.75rem;
    background-color: var(--surface-1); border: 1px solid var(--hairline);
  }
  .card-title { margin: 0; }
  .card-status { display: flex; gap: 0.625rem; align-items: flex-start; margin: 0; color: var(--fg-muted); }
  .card-status strong { color: var(--fg); }
  .card-status :global(.status-icon) { color: var(--accent); margin-top: 0.2rem; }
  .own-palm summary { list-style: none; }
  .own-palm summary::-webkit-details-marker { display: none; }
  .own-palm[open] summary { border-color: var(--control-border); }
  .own-body { display: flex; flex-direction: column; gap: 1rem; padding-top: 1rem; }
  .own-body p { margin: 0; }
  @media (min-width: 48rem) {
    .upload-card { padding: 1.75rem; }
  }
</style>
