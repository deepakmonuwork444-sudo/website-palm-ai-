---
/**
 * /app/ and /hi/app/ (SEO_PLAYBOOK.md §3, UX_PSYCHOLOGY.md §8): the full
 * hand-off. Device-aware store button with the price line, QR + remote
 * install on desktop, the honest note on iPhone. Only features the app has
 * today; prices from site.ts ([verify] against Play before launch).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../Icon.astro';
import StoreButton from '../StoreButton.astro';
import { site, type Locale } from '../../config/site';
import { localizePath, t } from '../../i18n';
import { mobileApplicationSchema, organizationSchema } from '../../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const page = dict.appPage;
const path = localizePath('/app/', locale);
const crumbs = [
  { name: dict.nav.home, path: localizePath('/', locale) },
  { name: dict.nav.app, path },
];
const jsonLd = [organizationSchema(), mobileApplicationSchema({ locale, description: dict.meta.appDescription })];
const { planFromPerMonth, packFrom } = site.appPrices;
---

<BaseLayout title={dict.meta.appTitle} description={dict.meta.appDescription} path={path} locale={locale} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs items={crumbs} label={dict.a11y.breadcrumb} />
  </div>

  <section class="wrap app-hero" aria-labelledby="app-h1">
    <div class="app-hero-copy">
      <h1 id="app-h1" class="font-display text-h1 tracking-display-en">{page.h1}</h1>
      <p class="text-lead text-fg-muted measure">{page.lead}</p>
      <p class="play-name text-small">
        <Icon name="info" class="info-icon" />
        <span>{dict.store.playName(site.appNameOnPlay)}</span>
      </p>
    </div>
    <div id="get" class="get-card">
      <h2 class="text-h3 font-bold">{page.getTitle}</h2>
      <StoreButton locale={locale} medium="app_page" campaign="get" showQr />
      <p class="text-small text-fg-muted">{page.continuity}</p>
    </div>
  </section>

  <div class="wrap app-body">
    <section aria-labelledby="does-title" class="app-section">
      <h2 id="does-title" class="text-h2 font-bold">{page.doesTitle}</h2>
      <ul class="ticks">
        {page.does.map((item) => <li><Icon name="check" class="tick" /><span>{item}</span></li>)}
      </ul>
    </section>

    <section aria-labelledby="price-title" class="app-section">
      <h2 id="price-title" class="text-h2 font-bold">{page.priceTitle}</h2>
      <ul class="price-list">
        <li>{page.price.freeReadings}</li>
        <li>{page.price.plans(planFromPerMonth)}</li>
        <li>{page.price.packs(packFrom)}</li>
        <li>{page.price.payment}</li>
      </ul>
    </section>

    <section aria-labelledby="privacy-title" class="app-section">
      <h2 id="privacy-title" class="text-h2 font-bold">{page.privacyTitle}</h2>
      <p class="measure">{page.privacyBody}</p>
      <p class="links-row">
        <a class="text-link" href="/privacy.html" hreflang={locale === 'hi' ? 'en' : undefined}>{page.privacyLink}</a>
        <a class="text-link" href="/delete-account.html" hreflang={locale === 'hi' ? 'en' : undefined}>{page.deleteLink}</a>
      </p>
    </section>

    <section aria-labelledby="limits-title" class="app-section limits">
      <h2 id="limits-title" class="text-h2 font-bold">{page.limitsTitle}</h2>
      <p class="measure">{page.limits}</p>
      <p class="measure text-fg-muted">{page.limitsMore}</p>
    </section>

    <section aria-labelledby="faq-title" class="app-section">
      <h2 id="faq-title" class="text-h2 font-bold">{page.faqTitle}</h2>
      <div class="faq">
        {
          page.faq.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a(planFromPerMonth, packFrom)}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .app-hero { display: grid; gap: 2rem; padding-block: 0.5rem 3rem; }
  .app-hero-copy { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }
  .app-hero-copy h1, .app-hero-copy p { margin: 0; }
  .play-name { display: flex; gap: 0.5rem; align-items: flex-start; color: var(--fg-muted); }
  .play-name :global(.info-icon) { color: var(--accent); margin-top: 0.15rem; }
  .get-card { display: flex; flex-direction: column; gap: 1.25rem; padding: 1.5rem; border-radius: 1.75rem;
    background-color: var(--surface-1); border: 1px solid var(--hairline); min-width: 0; }
  .get-card h2, .get-card p { margin: 0; }
  @media (min-width: 64rem) {
    .app-hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 4rem; padding-block: 1rem 5rem; }
  }

  .app-body { display: grid; gap: 3rem; padding-bottom: var(--section); }
  .app-section h2 { margin: 0 0 1rem; }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .ticks li { display: flex; gap: 0.625rem; align-items: flex-start; }
  .ticks :global(.tick) { color: var(--accent); margin-top: 0.2rem; }
  .price-list { margin: 0; padding-inline-start: 1.25rem; list-style: disc; display: flex; flex-direction: column; gap: 0.5rem; }
  .price-list li::marker { color: var(--accent); }
  .links-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .links-row a { display: inline-flex; align-items: center; min-height: 3rem; }
  .limits { padding: 1.5rem; border-radius: 1.25rem; background-color: var(--surface-2); }
  .limits p { margin: 0 0 0.5rem; }
  .faq { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary { display: flex; align-items: center; min-height: 3rem; padding-block: 0.5rem; cursor: pointer; font-weight: 700; }
  .faq p { margin: 0 0 1rem; color: var(--fg-muted); }
  @media (min-width: 64rem) {
    .app-body { grid-template-columns: 1fr 1fr; column-gap: 4rem; }
    .limits, .app-section:last-child { grid-column: 1 / -1; }
  }
</style>
