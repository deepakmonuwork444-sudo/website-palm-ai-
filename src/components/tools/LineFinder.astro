---
/**
 * The picker for tools 4–7 (server-rendered). Real radio groups with visible
 * labels and palm thumbnails, "Not sure" in every question, one gold action.
 * The page's own <script> calls mountFinder() with that line's data, so each
 * page ships only its own line's rules.
 */
import Icon from '../Icon.astro';
import MiniPalm from './MiniPalm.astro';
import { NOT_SURE, type LineFinder } from '../../lib/tools/finder';
import { THUMB_VIEW } from '../../lib/tools/palm-geometry';

interface Props {
  finder: LineFinder;
  lineName: string;
}

const { finder, lineName } = Astro.props;
---

<div class="t-card" data-finder={finder.line}>
  <form class="t-form" novalidate aria-label={`Describe your ${lineName}`}>
    {
      finder.questions.map((question) => {
        const thumbs = question.options.some((option) => option.thumb);
        return (
          <fieldset class="t-q" data-q={question.id}>
            <legend class="t-q-legend">{question.legend}</legend>
            {question.help && <p class="t-q-help">{question.help}</p>}
            <div class={thumbs ? 't-opts' : 't-opts-text'}>
              {question.options.map((option) => (
                <label class="t-opt">
                  <input class="t-opt-input" type="radio" name={question.id} value={option.value} />
                  <span class="t-opt-box">
                    {option.thumb && <MiniPalm paths={option.thumb} view={THUMB_VIEW[finder.line]} />}
                    <span class="t-opt-text">
                      <Icon name="check" class="t-opt-check" />
                      <span>{option.label}</span>
                    </span>
                  </span>
                </label>
              ))}
              <label class="t-opt">
                <input class="t-opt-input" type="radio" name={question.id} value={NOT_SURE} />
                <span class="t-opt-box t-opt-row"><Icon name="check" class="t-opt-check" />Not sure</span>
              </label>
            </div>
          </fieldset>
        );
      })
    }
    <div class="t-actions">
      <button type="submit" class="btn btn-gold">Show what the books say</button>
      <button type="reset" class="btn btn-secondary">Clear my answers</button>
    </div>
  </form>
  <noscript><p class="t-noscript">This finder needs JavaScript. Every meaning is also listed below under “What palmistry says”.</p></noscript>
  <p class="t-sr" role="status" data-status></p>
  <div class="t-result" id="result" data-result></div>
</div>
