---
/**
 * Palm reading quiz (tool 12): one question at a time on the porcelain 3D hand.
 * The first question is server-rendered; the script runs the rest. Options
 * are real buttons; right/wrong is said in words and with an icon, never by
 * colour alone (DESIGN_SYSTEM.md §12).
 */
import { FRAME, HAND_IMAGE, LINE_ORDER, LINE_PATHS, MAP_VIEWBOX, MOUNT_AREAS, MOUNT_ORDER } from '../../lib/tools/palm-geometry';
import { QUIZ } from '../../lib/tools/quiz';

const first = QUIZ[0]!;
---

<div class="t-card" data-quiz>
  <p class="t-quiz-progress" data-progress>Question 1 of {QUIZ.length}</p>
  <div class="t-quiz-body" data-body>
    <div class="t-quiz-figure" data-figure>
      <svg class="t-map-svg t-quiz-svg t-fig" viewBox={MAP_VIEWBOX} role="img" aria-label="A right palm (a 3D model) with one part highlighted." data-quiz-svg>
        <defs>
          <linearGradient id="t-quiz-fade-g" gradientUnits="userSpaceOnUse" x1="0" y1="150" x2="0" y2="1120"><stop offset="0" stop-color="black" /><stop offset="0.145" stop-color="white" /><stop offset="0.9" stop-color="white" /><stop offset="1" stop-color="black" /></linearGradient>
          <mask id="t-quiz-fade" maskUnits="userSpaceOnUse" x="0" y="0" width={FRAME.width} height={FRAME.height}><rect width={FRAME.width} height={FRAME.height} fill="url(#t-quiz-fade-g)" /></mask>
        </defs>
        {/* The fingertips and the wrist run off the view: fade them out softly. */}
        <image href={HAND_IMAGE.large} x="0" y="0" width={FRAME.width} height={FRAME.height} mask="url(#t-quiz-fade)" />
        {
          MOUNT_ORDER.map((id) => {
            const area = MOUNT_AREAS[id];
            return <ellipse class="t-quiz-mount" data-mount={id} cx={area.cx} cy={area.cy} rx={area.rx} ry={area.ry} />;
          })
        }
        {
          LINE_ORDER.map((line) => (
            <g class:list={['t-quiz-line', { 'is-on': 'line' in (first.show ?? {}) && (first.show as { line: string }).line === line }]} data-line={line}>
              <path class="t-halo" d={LINE_PATHS[line]} />
              <path class="t-line t-l-quiz" d={LINE_PATHS[line]} />
            </g>
          ))
        }
      </svg>
    </div>
    <div class="t-quiz-q">
      <h2 class="t-result-title" id="quiz-prompt" data-prompt>{first.prompt}</h2>
      <div class="t-quiz-options" role="group" aria-labelledby="quiz-prompt" data-options>
        {
          first.options.map((option) => (
            <button type="button" class="t-quiz-option" data-option={option.id}>
              {option.label}
            </button>
          ))
        }
      </div>
      <p class="t-quiz-feedback" aria-live="polite" data-feedback></p>
      <button type="button" class="btn btn-gold" data-next hidden>Next question</button>
    </div>
  </div>
  <div class="t-quiz-score" data-score hidden></div>
  <noscript><p class="t-noscript">The quiz needs JavaScript. What it covers is listed below.</p></noscript>
</div>
