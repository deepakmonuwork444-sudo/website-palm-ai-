---
/**
 * The picker and status frame of an on-device photo tool (hand type, finger
 * reader): camera + gallery file inputs on phones (the phone's own camera app
 * is better), "Use laptop camera" on desktops (WebcamButton, WEB-DEC-059),
 * the privacy line ONCE, the one-time download note, a progress
 * panel and the result area. The script (src/lib/tools/client/*) fills it.
 */
import Icon from '../Icon.astro';
import DropPalm from './DropPalm.astro';
import ContinueOnPhone from './ContinueOnPhone.astro';
import WebcamButton from './WebcamButton.astro';
import { downloadMb } from '../../lib/tools/hand/model-files';

interface Props {
  id: string;
  /** What the photo should show, as short tips. */
  tips: string[];
  /** Extra note under the tips (e.g. how to hold the hand). */
  hold?: string;
}

const { id, tips, hold } = Astro.props;
---

<div class="t-card t-photo-tool" data-photo-tool={id}>
  <div class="t-result" data-result aria-live="off"></div>

  <div class="t-work" data-work hidden>
    <span class="t-work-spin" aria-hidden="true"></span>
    <div class="t-work-body">
      <p class="t-work-text" data-work-text></p>
      <progress class="t-work-bar" data-work-bar hidden aria-label="Download progress"></progress>
    </div>
  </div>

  <div class="t-pc-start t-drop" data-start>
    <DropPalm />
    <div class="t-actions">
      <input id={`${id}-camera`} class="t-file-input" type="file" accept="image/*" capture="environment" data-file />
      <label for={`${id}-camera`} class="btn btn-gold t-file-label only-touch" data-camera-label>
        <Icon name="camera" /><span data-first-label data-again-text="Take another photo">Take a palm photo</span>
      </label>
      <WebcamButton forInput={`${id}-gallery`} />
      <input id={`${id}-gallery`} class="t-file-input" type="file" accept="image/*" data-file />
      <label for={`${id}-gallery`} class="btn btn-secondary t-file-label t-pc-gallery" data-gallery-label>
        <Icon name="image" /><span data-first-label data-again-text="Choose another photo">Choose a photo</span>
      </label>
    </div>
    <p class="t-privacy">
      <Icon name="shield" />
      <span>Runs on your device: your photo never leaves this device. Nothing is uploaded or saved.</span>
    </p>
    <ul class="t-pc-tips" aria-label="How to take the photo" data-first-only>
      {tips.map((tip) => <li><Icon name="check" /><span>{tip}</span></li>)}
    </ul>
    {hold && <p class="t-caveat" data-first-only>{hold}</p>}
    <p class="t-caveat" data-first-only>
      The first time, your browser downloads our hand finder: up to {downloadMb()} MB, once. After that it starts at once.
    </p>
    <p class="t-caveat" data-inapp hidden>
      If choosing a photo doesn’t work in this app’s browser, open this page in Chrome.
    </p>
    <ContinueOnPhone />
  </div>

  <noscript><p class="t-noscript">This tool needs JavaScript to find your hand. The explanation below still applies.</p></noscript>
  <p class="t-sr" role="status" aria-live="polite" data-status></p>
</div>
