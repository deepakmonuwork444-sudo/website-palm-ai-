---
/**
 * Palm photo checker (tool 3): camera or gallery → a 96px canvas copy →
 * the app's pixel checks, all in the browser. No network request carries the
 * image (verified in the gate run). File inputs, not getUserMedia: the site's
 * Permissions-Policy blocks camera access, and the phone's own camera app is
 * the better camera anyway (capture="environment").
 */
import Icon from '../Icon.astro';
---

<div class="t-card" data-photo-check>
  <div class="t-pc-review" data-review hidden>
    <figure class="t-pc-photo">
      <img data-preview alt="Your palm photo, shown only on this device" />
      <figcaption class="t-caveat">Shown only on this device.</figcaption>
    </figure>
    <div class="t-pc-results">
      <h2 class="t-result-title" data-verdict-title>Checking your photo</h2>
      <p class="t-result-lead" data-verdict-text></p>
      <ul class="t-checks" data-checks aria-label="Photo checks"></ul>
      <div class="t-pc-after" data-after></div>
    </div>
  </div>

  <div class="t-pc-start" data-start>
    <div class="t-actions">
      <input id="pc-camera" class="t-file-input" type="file" accept="image/*" capture="environment" data-file />
      <label for="pc-camera" class="btn btn-gold t-file-label only-touch" data-camera-label>Take a palm photo</label>
      <input id="pc-gallery" class="t-file-input" type="file" accept="image/*" data-file />
      <label for="pc-gallery" class="btn btn-secondary t-file-label t-pc-gallery" data-gallery-label>Choose a photo</label>
    </div>
    <p class="t-privacy">
      <Icon name="shield" />
      <span>Runs on your phone — your photo never leaves this device. Nothing is uploaded or saved; close the page and it is gone.</span>
    </p>
    <ul class="t-pc-tips" aria-label="Tips for a good palm photo" data-tips>
      <li><Icon name="check" /><span>Open palm, fingers together</span></li>
      <li><Icon name="check" /><span>Good light, no flash glare</span></li>
      <li><Icon name="check" /><span>Whole palm in the frame</span></li>
    </ul>
  </div>

  <noscript><p class="t-noscript">The photo checker needs JavaScript. The tips below still apply.</p></noscript>
  <p class="t-sr" role="status" data-status></p>
</div>
