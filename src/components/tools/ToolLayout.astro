---
/**
 * The tool-page template (CONTENT_GUIDE.md §6, DESIGN_SYSTEM.md §7.7, tool-page
 * skill): breadcrumb → icon tile + H1 → promise + honesty label → THE TOOL
 * (default slot) → "check it on your own palm" → how it works → what palmistry
 * says (sourced) → what this tool can't tell you → FAQ → links → end block,
 * with the other tools (each with its 3D icon) in a sticky aside on desktop.
 *
 * Schema: WebApplication (price 0, no ratings) + BreadcrumbList. Links render
 * only to pages that are live (no broken links while guides are being built).
 */
import './tools.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Icon from '../Icon.astro';
import StoreButton from '../StoreButton.astro';
import MediaIcon from '../MediaIcon.astro';
import { findPage, isLive } from '../../config/pages';
import { site } from '../../config/site';
import { t } from '../../i18n';
import { pageEntities } from '../../lib/entities';
import { pageId, webApplicationSchema, webPageSchema } from '../../lib/schema';
import { scanAction } from '../../lib/reading/open';
import { otherTools, TOOLS, toolMedium, type ToolInfo } from '../../lib/tools/registry';
import { TOOL_ICON } from '../../lib/tools/tool-icons';

export interface HowStep {
  title: string;
  body: string;
}
export interface SaysItem {
  term: string;
  text: string;
  source?: string;
}
export interface Faq {
  q: string;
  a: string;
}
export interface ToolLink {
  href: string;
  label: string;
}

interface Props {
  tool: ToolInfo;
  title: string;
  description: string;
  h1: string;
  promise: string;
  how: HowStep[];
  /** Line-specific "how to find it" section (SEO_PLAYBOOK.md §15: each finder carries its own). */
  spot?: { title: string; paras: string[] };
  howTitle?: string;
  /** "What palmistry says": items, or the `says` slot for custom content. */
  saysTitle?: string;
  saysIntro?: string;
  says?: SaysItem[];
  /** Tool-specific limits, added to the standard limits box (CONTENT_GUIDE.md §4.11). */
  limits: string[];
  /** Topic line of the limits box. */
  limitsTopic?: string;
  /** The care line (life-line pages only, CONTENT_GUIDE.md §4.3 rule 12). */
  careLine?: boolean;
  faq: Faq[];
  links: ToolLink[];
  /** Show the "check it on your own palm" block (off for tools that already use a photo). */
  ownPalm?: boolean;
}

const {
  tool,
  title,
  description,
  h1,
  promise,
  how,
  howTitle = 'How it works',
  spot,
  saysTitle = 'What palmistry says',
  saysIntro,
  says = [],
  limits,
  limitsTopic,
  careLine = false,
  faq,
  links,
  ownPalm = true,
} = Astro.props;

// Link words to /app/ rotate between its registered anchors (WEB-DEC-051, R1/R3), never "See what the app does".
const APP_ANCHORS = ['PalmSays palm reading app', 'Palm reading app for Android', 'What the app reads'];
const appAnchor = APP_ANCHORS[[...tool.path].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % APP_ANCHORS.length];

if (!findPage(tool.path)) throw new Error(`ToolLayout: ${tool.path} is not in src/config/pages.ts`);

const dict = t('en');
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Tools', path: '/tools/' },
  { name: tool.name, path: tool.path },
];
const entities = pageEntities(tool.path);
const jsonLd = [
  webPageSchema({ path: tool.path, name: title, locale: 'en', entities, breadcrumb: true, mainEntity: pageId(tool.path, 'app') }),
  webApplicationSchema({ name: tool.name, path: tool.path, locale: 'en', description, entities, inToolsCollection: true }),
];
const medium = toolMedium(tool.id);
// A tool whose registry flag says "not open yet" (the palm line finder) is not linked: it would be a dead end. It comes back when its flag turns live.
const toolOpen = (path: string) => TOOLS.find((item) => item.path === path)?.live !== false;
const liveLinks = links.filter((link) => isLive(link.href) && (link.href === '/' || toolOpen(link.href)));
// The free reading's entry leads to the scan that works today: the web scan when open, else the app (as the guides do).
const scan = scanAction('en', { medium, campaign: 'other_tools' });
const others = otherTools(tool.id)
  .filter((other) => isLive(other.path) && (other.id === 'free-reading' || other.live))
  .map((other) =>
    other.id === 'free-reading' ? { ...other, href: scan.href, name: scan.app ? 'Free palm reading in our app' : other.name } : { ...other, href: other.path },
  );
const readingLive = site.webReadingEnabled;
---

<BaseLayout title={title} description={description} path={tool.path} locale="en" jsonLd={jsonLd}>
  <div class="wrap t-page" data-tool-page={tool.id} data-tool-kind={tool.kind} data-reading-live={String(readingLive)}>
    <Breadcrumbs items={crumbs} label={dict.a11y.breadcrumb} />

    <div class="t-grid">
      <div class="t-main">
        <header class="t-head">
          <div class="t-title-row">
            <span class="t-tile"><MediaIcon name={TOOL_ICON[tool.id]} class="t-tile-icon" /></span>
            <h1 class="t-h1">{h1}</h1>
          </div>
          <p class="t-promise">{promise}</p>
          <p class="t-label"><Icon name="info" /><span>{tool.label}</span></p>
        </header>

        <slot />

        {
          ownPalm && (
            <section class="t-next showroom-reveal" aria-labelledby="own-palm-title">
              <h2 id="own-palm-title" class="text-h3 font-bold">
                Check it on your own palm
              </h2>
              {readingLive ? (
                <p>Take one photo and see your own lines traced, with what the books say about each one.</p>
              ) : (
                <p>
                  Our Android app traces your own lines on your photo and reads each one from the same books. The free web reading
                  on this site opens soon.
                </p>
              )}
              <p>
                {readingLive ? (
                  <a class="text-link" href="/#read">
                    Read my palm free
                  </a>
                ) : (
                  <a class="text-link" href="/app/">
                    {appAnchor}
                  </a>
                )}
              </p>
            </section>
          )
        }

        <section class="t-section showroom-reveal" aria-labelledby="how-title">
          <h2 id="how-title">{howTitle}</h2>
          <ol class="t-steps">
            {
              how.map((step) => (
                <li class="t-step">
                  <span class="t-step-title">{step.title}</span>
                  <span class="t-step-body">{step.body}</span>
                </li>
              ))
            }
          </ol>
        </section>

        {
          spot && (
            <section class="t-section showroom-reveal" aria-labelledby="spot-title">
              <h2 id="spot-title">{spot.title}</h2>
              <div class="t-prose">
                {spot.paras.map((para) => <p>{para}</p>)}
              </div>
            </section>
          )
        }

        <section class="t-section showroom-reveal" aria-labelledby="says-title">
          <h2 id="says-title">{saysTitle}</h2>
          {saysIntro && <p class="t-prose">{saysIntro}</p>}
          {
            says.length > 0 && (
              <ul class="t-says">
                {says.map((item) => (
                  <li class="t-say">
                    <span class="t-say-term">{item.term}</span>
                    <span>{item.text}</span>
                    {item.source && <span class="t-source">{item.source}</span>}
                  </li>
                ))}
              </ul>
            )
          }
          <slot name="says" />
        </section>

        <section class="t-section showroom-reveal" aria-labelledby="limits-title">
          <h2 id="limits-title">What this tool can’t tell you</h2>
          <div class="t-limits">
            <p>
              <strong>What palmistry can’t tell you.</strong> Palm lines can’t tell dates, how long you’ll live, your health, whether
              or when you’ll marry, how many children you’ll have, or how much money you’ll make.{limitsTopic ? ` ${limitsTopic}` : ''}
              Palmistry is a tradition for reflection, not a science.
              {isLive('/is-palmistry-real/') && <>{' '}<a class="text-link" href="/is-palmistry-real/">Is palmistry real?</a></>}
            </p>
            <ul>
              {limits.map((line) => <li>{line}</li>)}
            </ul>
            {
              careLine && (
                <p class="t-care">
                  If worry about health or life is weighing on you, talk to someone: Tele-MANAS 14416 (India, free, 24×7) or 988 (US).
                </p>
              )
            }
          </div>
        </section>

        <section class="t-section showroom-reveal" aria-labelledby="faq-title">
          <h2 id="faq-title">Questions about this tool</h2>
          <div class="t-faq">
            {
              faq.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p class="t-faq-a">{item.a}</p>
                </details>
              ))
            }
          </div>
        </section>

        {
          liveLinks.length > 0 && (
            <section class="t-section showroom-reveal" aria-labelledby="links-title">
              <h2 id="links-title">Keep going</h2>
              <ul class="t-links">
                {liveLinks.map((link) => (
                  <li>
                    <a class="text-link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="t-end showroom-reveal" aria-labelledby="end-title" data-placement="end_block">
          <div class="t-prose">
            <h2 id="end-title" class="text-h2 font-bold">Your whole palm, in our app</h2>
            <p class="text-fg-muted">
              In the app: all 4 parts of your reading, your lines traced on your photo, both hands compared, short lessons and a quiz,
              in Hindi and English, with no ads.
            </p>
            <p class="text-small">{dict.appPage.continuity}</p>
          </div>
          <StoreButton locale="en" medium={medium} campaign="end_block" showQr />
        </section>
      </div>

      <aside class="t-aside t-other" aria-labelledby="other-tools-title">
        <h2 id="other-tools-title">Other free tools</h2>
        <ul>
          {
            others.map((other) => (
              <li>
                <a href={other.href}>
                  <span class="t-other-icon"><MediaIcon name={TOOL_ICON[other.id]} /></span>
                  <span>{other.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="text-small">
          <a class="text-link" href="/tools/">All tools</a>
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>
