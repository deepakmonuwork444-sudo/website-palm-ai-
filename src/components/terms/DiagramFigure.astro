---
/**
 * One of our diagram FILES (src/lib/diagrams.ts; scripts/make-diagrams.mjs, make-palm-chart.mjs) as a
 * lazy <figure>: the wide file from 40rem, the tall phone layout below it (words stay readable), the
 * caption with the CC BY 4.0 line and the full-size PNG link (WEB-DEC-050/053). Same look as PalmChart.
 * Zero JS. A page that shows a diagram lists its path in the diagram's `pages` (image sitemap, checks).
 *
 *   <DiagramFigure id="heart-line-start-end-and-types" />
 *   <DiagramFigure id="…" compact />   (gallery card: the wide file only, smaller)
 *   <DiagramFigure id="…" reuse="details" />   (blog posts: the licence + PNG link fold into "Reuse this image")
 */
import { isLive } from '../../config/pages';
import { site } from '../../config/site';
import { diagram, diagramPng, DIAGRAM_DIR } from '../../lib/diagrams';

interface Props {
  id: string;
  /** Override the registry alt / caption (same language as the page). */
  alt?: string;
  caption?: string;
  /** Gallery card: the wide file only, no licence sentence (the gallery says it once). */
  compact?: boolean;
  /** Extra line under the caption, e.g. a link to the guide the diagram belongs to. */
  more?: { href: string; text: string } | undefined;
  /** Blog posts: the licence sentence and the PNG link sit in a closed "Reuse this image" <details> (styled by blog.css). */
  reuse?: 'inline' | 'details';
  /** The post cover at the top of a blog post: loaded at once, not lazily. */
  eager?: boolean;
}

const { id, alt, caption, compact = false, more, reuse = 'inline', eager = false } = Astro.props;
const folded = reuse === 'details' && !compact;
const item = diagram(id);
const base = `${DIAGRAM_DIR}${item.id}`;
const sizes = compact ? '(min-width: 48rem) 22rem, calc(100vw - 3rem)' : '(min-width: 48rem) 42.5rem, calc(100vw - 2rem)';
const { name: licenceName, credit, pagePath } = site.diagramLicence;
const policyLive = isLive(pagePath.split('#')[0] ?? pagePath);
---

<figure class:list={['dg', compact && 'dg-compact']} id={compact ? undefined : item.id}>
  <div class="dg-art">
    <picture>
      {!compact && <source media="(max-width: 39.99rem)" type="image/avif" srcset={`${base}-tall.avif`} width={item.tall.width} height={item.tall.height} />}
      {!compact && <source media="(max-width: 39.99rem)" type="image/webp" srcset={`${base}-tall.webp`} width={item.tall.width} height={item.tall.height} />}
      <source type="image/avif" srcset={`${base}-900.avif 900w, ${base}.avif ${item.width}w`} sizes={sizes} />
      <img
        class="dg-img"
        src={`${base}.webp`}
        srcset={`${base}-900.webp 900w, ${base}.webp ${item.width}w`}
        sizes={sizes}
        width={item.width}
        height={item.height}
        alt={alt ?? item.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={eager ? 'high' : undefined}
      />
    </picture>
  </div>
  {
    folded ? (
      <figcaption class="dg-caption">
        {caption ?? item.caption}
        <details class="dg-reuse">
          <summary>Reuse this image</summary>
          <p>
            Free to reuse under {policyLive ? <a class="text-link" href={pagePath}>{licenceName}</a> : licenceName} with credit to {credit}.{' '}
            <a class="text-link" href={diagramPng(item)}>Full-size diagram (PNG, {item.width} × {item.height})</a>
          </p>
        </details>
      </figcaption>
    ) : (
      <figcaption class="dg-caption">
        {compact ? <strong class="dg-name">{item.name}</strong> : caption ?? item.caption}
        {!compact && (
          <>
            {' '}Free to reuse under {policyLive ? <a class="text-link" href={pagePath}>{licenceName}</a> : licenceName} with credit to {credit}.
          </>
        )}
        {' '}<span class="dg-links">
          <a class="text-link" href={diagramPng(item)}>Full-size diagram (PNG, {item.width} × {item.height})</a>
          {more && <span>Guide: <a class="text-link" href={more.href}>{more.text}</a></span>}
        </span>
      </figcaption>
    )
  }
</figure>

<style>
  .dg { margin: 1.5rem 0 2rem; display: flex; flex-direction: column; gap: 0.875rem; }
  .dg-art {
    padding: 0.5rem; border-radius: var(--r-panel); border: 1px solid transparent; overflow: hidden;
    background: var(--glass-1) padding-box, var(--rim) border-box; box-shadow: var(--shine), var(--e2);
  }
  .dg-img { display: block; width: 100%; height: auto; border-radius: calc(var(--r-panel) - 0.5rem); }
  .dg-caption { margin: 0; font-size: var(--fs-small); line-height: 1.55; color: var(--fg-muted); }
  .dg-compact { margin: 0; gap: 0.625rem; }
  .dg-compact .dg-art { padding: 0.375rem; border-radius: var(--r-card); }
  .dg-compact .dg-img { border-radius: calc(var(--r-card) - 0.375rem); }
  .dg-links { display: inline; }
  .dg-compact .dg-links { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.25rem; }
  .dg-name { display: block; color: var(--fg); font-weight: 700; }
</style>
