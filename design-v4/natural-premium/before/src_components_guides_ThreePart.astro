---
/**
 * The three-part block for a sensitive meaning (CONTENT_GUIDE.md §4.4):
 * what you see, what the tradition says (attributed), what it can't tell you
 * and what you can do. Inline markdown is allowed in each part.
 */
import { localeFromPath } from '../../i18n';
import { inlineMarkdown } from '../../lib/guides/guides';
import { guideStrings } from '../../lib/guides/strings';

interface Props {
  see: string;
  says: string;
  cant: string;
}

const { see, says, cant } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const s = guideStrings(locale);
const rows = [
  { label: s.whatWeSee, text: see },
  { label: s.whatTraditionSays, text: says },
  { label: s.whatItCantTell, text: cant },
];
---

<dl class="three glass-panel guide-block">
  {
    rows.map((row) => (
      <div class="three-row">
        <dt class="text-small font-bold">{row.label}</dt>
        <dd set:html={inlineMarkdown(row.text, locale)} />
      </div>
    ))
  }
</dl>

<style>
  /* Showroom: three lit rows in one glass panel. */
  .three { margin: 2rem 0; padding: 0; border-radius: var(--r-card); overflow: hidden; }
  .three-row { position: relative; padding: 1.125rem 1.25rem 1.125rem 1.5rem; border-top: 1px solid var(--edge); }
  .three-row:first-child { border-top: none; }
  .three-row::before {
    content: ""; position: absolute; left: 0; top: 1.3rem; width: 3px; height: 1rem; border-radius: 0 3px 3px 0; background: var(--accent); opacity: 0.8;
  }
  .three-row:last-child { background: linear-gradient(160deg, color-mix(in srgb, var(--line-head) 10%, transparent), transparent 70%); }
  .three dt { color: var(--accent); margin: 0 0 0.25rem; letter-spacing: 0.01em; }
  .three dd { margin: 0; }
  @media (min-width: 40rem) { .three-row { padding: 1.25rem 1.75rem 1.25rem 2rem; } .three-row::before { top: 1.4rem; } }
</style>
