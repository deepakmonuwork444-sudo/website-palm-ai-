---
/**
 * Bilingual 404 (noindex, never in a sitemap). Served by Workers for any
 * unknown path (wrangler.jsonc not_found_handling: 404-page).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';

const en = t('en');
const hi = t('hi');
---

<BaseLayout title={en.meta.notFoundTitle} description={en.meta.notFoundDescription} path="/404" locale="en">
  <section class="wrap not-found">
    <div class="nf-panel glass-panel">
    <h1 class="font-display text-h1 tracking-display-en">{en.notFound.title}</h1>
    <p class="text-lead text-fg-muted">{en.notFound.body}</p>
    <p><a class="btn btn-gold" href="/">{en.notFound.home}</a></p>
    <div lang="hi" class="not-found-hi">
      <h2 class="text-h2 font-bold">{hi.notFound.title}</h2>
      <p class="text-fg-muted">{hi.notFound.body}</p>
      <p><a class="text-link" href="/hi/">{hi.notFound.home}</a></p>
    </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { padding-block: 2.5rem 5rem; }
  .nf-panel { position: relative; overflow: hidden; isolation: isolate; max-width: 40rem; margin-inline: auto; padding: 2.25rem 1.5rem 2rem; display: flex; flex-direction: column; gap: 1rem; }
  /* A soft pool of light behind the heading. */
  .nf-panel::before {
    content: ""; position: absolute; z-index: -1; top: -40%; left: -20%; width: 80%; height: 90%; pointer-events: none; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(124,96,236,0.22), transparent);
  }
  .nf-panel::after {
    content: ""; position: absolute; left: 14%; right: 14%; top: -1px; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255,236,190,0.7), transparent);
  }
  :global([data-theme="day"]) .nf-panel::before { background: radial-gradient(closest-side, rgba(120,92,230,0.10), transparent); }
  :global([data-theme="day"]) .nf-panel::after { background: linear-gradient(90deg, transparent, rgba(160,110,20,0.45), transparent); }
  .not-found h1, .not-found h2, .not-found p { margin: 0; }
  .not-found h1 { text-wrap: balance; }
  .not-found .btn-gold { margin-top: 0.5rem; }
  .not-found-hi { margin-top: 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--edge); display: flex; flex-direction: column; gap: 0.75rem; }
  .not-found-hi h2 { font-size: var(--fs-h3); }
  .not-found-hi a { display: inline-flex; align-items: center; min-height: 3rem; }
  @media (min-width: 48rem) { .not-found { padding-block: 5rem 7rem; } .nf-panel { padding: 3rem 3rem 2.5rem; } }
</style>
