---
/**
 * "Find your line" panel (guide template v3), next to the real sample photo:
 * a curiosity prompt, 2–4 steps to check your own hand, optional answer chips
 * and the page's one gold action, "Scan my palm to see mine" (→ /reading/).
 *
 * Zero JS: the chips are real radio buttons; the picked answer shows through
 * :has(). Browsers without :has() show every answer, so nothing is lost.
 * While the web reading is off (site.webReadingEnabled), a note under the
 * button says so before the click, never after. The button is the page's
 * [data-hero-cta]: src/scripts/site.ts shows the shared mobile bottom bar and
 * the header's outline action only once it has scrolled away (as on home).
 */
import { isLive } from '../../config/pages';
import { site, type Locale } from '../../config/site';
import { localizePath } from '../../i18n';
import { inlineMarkdown } from '../../lib/guides/guides';
import { guideStrings } from '../../lib/guides/strings';
import Icon from '../Icon.astro';
import PrimaryButton from '../PrimaryButton.astro';

interface Choice {
  label: string;
  answer: string;
  href?: string | undefined;
  /** Link words for a chip that leaves the page (the target's name, WEB-DEC-051 R2). */
  link?: string | undefined;
}

interface Props {
  locale: Locale;
  title: string;
  prompt: string;
  steps: string[];
  question?: string | undefined;
  choices: Choice[];
  /** The page's scan action (false on pages that must not carry a CTA near their content). */
  showCta: boolean;
  tool?: { slug: string; name: string; label?: string | undefined } | undefined;
}

const { locale, title, prompt, steps, question, choices, showCta, tool } = Astro.props;
const s = guideStrings(locale);
const scanHref = locale === 'hi' ? '/reading/?lang=hi' : '/reading/';
const toolHref = tool ? localizePath(`/tools/${tool.slug}/`, locale) : null;
const toolLive = toolHref ? isLive(toolHref) : false;
---

<section class="fp glass-panel" aria-labelledby="find-title" data-find>
  <div class="fp-head">
    <span class="fp-mark glass-well" aria-hidden="true">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.5" /><circle cx="12" cy="12" r="2" /><path d="M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4" /></svg>
    </span>
    <h2 id="find-title" class="text-h3 font-bold fp-title">{title}</h2>
  </div>
  <p class="fp-prompt" set:html={inlineMarkdown(prompt, locale)} />
  <ol class="fp-steps">
    {steps.map((step) => <li><span set:html={inlineMarkdown(step, locale)} /></li>)}
  </ol>

  {
    choices.length > 0 && (
      <fieldset class="fp-choices">
        {question && <legend class="font-bold fp-question">{question}</legend>}
        <div class="fp-chips">
          {choices.map((choice, i) => (
            <span class="fp-chip">
              <input type="radio" name="find-choice" id={`find-choice-${i}`} value={String(i)} />
              <label for={`find-choice-${i}`}>
                <Icon name="check" class="fp-tick" />
                {choice.label}
              </label>
            </span>
          ))}
        </div>
        <div class="fp-answers" aria-live="polite">
          {choices.map((choice, i) => (
            <p class="fp-answer" data-i={String(i)}>
              <span set:html={inlineMarkdown(choice.answer, locale)} />
              {choice.href && (
                <>
                  {' '}
                  <a class="text-link" href={choice.href}>
                    {choice.link ?? (choice.href.startsWith('#type-') ? s.seeCard : choice.href.startsWith('#') ? s.seeSection : s.seeGuide)}
                  </a>
                </>
              )}
            </p>
          ))}
        </div>
      </fieldset>
    )
  }

  {
    showCta && (
      <div class="fp-cta" data-hero-cta>
        <PrimaryButton href={scanHref} block>
          {s.scanCta}
        </PrimaryButton>
        {!site.webReadingEnabled && <p class="text-small text-fg-muted fp-note">{s.scanSoon}</p>}
      </div>
    )
  }
  {toolLive && toolHref && tool && (
    <p class="text-small fp-tool">
      <a class="text-link" href={toolHref}>{tool.label ?? s.toolLink(tool.name)}</a>
    </p>
  )}
</section>

<style>
  /* Showroom: an instrument-like glass panel. Steps on a lit rail, answers in an inset well. */
  .fp { position: relative; display: flex; flex-direction: column; gap: 1.125rem; padding: 1.375rem 1.25rem 1.5rem; }
  .fp::before {
    content: ""; position: absolute; inset: -1px 2.5rem auto; height: 1px; pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(245,217,139,0.7) 30%, rgba(245,217,139,0.7) 70%, transparent);
  }
  :global([data-theme="day"]) .fp::before { background: linear-gradient(90deg, transparent, rgba(122,82,0,0.35) 30%, rgba(122,82,0,0.35) 70%, transparent); }
  .fp-head { display: flex; align-items: center; gap: 0.875rem; }
  .fp-mark { display: grid; place-items: center; flex: none; width: 2.75rem; height: 2.75rem; border-radius: 9999px; }
  .fp-mark svg { width: 1.375rem; height: 1.375rem; fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; }
  .fp-title { margin: 0; }
  .fp-prompt { margin: 0; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--fg); }

  .fp-steps { position: relative; margin: 0; padding: 0; list-style: none; counter-reset: fp; display: flex; flex-direction: column; gap: 0.875rem; }
  /* The rail that joins the step numbers. */
  .fp-steps::before {
    content: ""; position: absolute; top: 1rem; bottom: 1rem; left: calc(1rem - 0.5px); width: 1px;
    background: linear-gradient(180deg, rgba(230,184,92,0.55), rgba(230,184,92,0.08));
  }
  .fp-steps li { position: relative; counter-increment: fp; display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: 0.75rem; align-items: start; }
  .fp-steps li span { padding-top: 0.2rem; }
  .fp-steps li::before {
    content: counter(fp); display: inline-flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem; border-radius: 9999px; font-weight: 700; font-size: var(--fs-small);
    color: var(--accent); border: 1px solid transparent;
    background: radial-gradient(circle at 50% 30%, var(--color-ink-4), var(--color-ink-7)) padding-box, linear-gradient(145deg, rgba(245,217,139,0.8), rgba(230,184,92,0.15)) border-box;
    box-shadow: 0 0 16px -4px rgba(230,184,92,0.5);
  }
  :global([data-theme="day"]) .fp-steps li::before {
    background: linear-gradient(180deg, var(--color-white), var(--color-day-page-2)) padding-box, linear-gradient(145deg, rgba(122,82,0,0.6), rgba(122,82,0,0.15)) border-box;
    box-shadow: 0 4px 10px -6px rgba(122,82,0,0.4);
  }

  .fp-choices {
    margin: 0; padding: 1rem; min-width: 0; border-radius: var(--r-card); border: 1px solid transparent;
    background: var(--well) padding-box, linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0.02)) border-box;
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.3);
  }
  :global([data-theme="day"]) .fp-choices {
    background: var(--well) padding-box, linear-gradient(180deg, rgba(23,19,61,0.07), rgba(255,255,255,1)) border-box;
    box-shadow: inset 0 2px 8px rgba(23,19,61,0.06);
  }
  .fp-question { padding: 0; margin-bottom: 0.75rem; float: left; width: 100%; }
  .fp-chips { clear: both; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .fp-chip { position: relative; display: inline-flex; }
  .fp-chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .fp-chip label {
    display: inline-flex; align-items: center; gap: 0.375rem; min-height: 3rem; padding: 0.5rem 1.125rem;
    border-radius: 9999px; border: 1px solid transparent; color: var(--fg); cursor: pointer;
    background: linear-gradient(180deg, rgba(255,255,255,0.09), rgba(255,255,255,0.025)) padding-box, var(--rim) border-box;
    box-shadow: var(--shine), 0 6px 16px -10px rgba(0,0,0,0.6);
    transition: transform 220ms var(--ease-out), box-shadow 320ms var(--ease-out), background 200ms var(--ease);
  }
  :global([data-theme="day"]) .fp-chip label { background: linear-gradient(180deg, var(--color-white), var(--color-day-page)) padding-box, var(--rim) border-box; box-shadow: var(--shine), 0 4px 12px -8px rgba(23,19,61,0.25); }
  .fp-chip input:hover + label { background: linear-gradient(180deg, rgba(255,255,255,0.14), rgba(255,255,255,0.04)) padding-box, var(--rim-hover) border-box; }
  :global([data-theme="day"]) .fp-chip input:hover + label { background: linear-gradient(180deg, var(--color-white), var(--color-day-page)) padding-box, var(--rim-hover) border-box; }
  .fp-chip input:active + label { transform: scale(0.97); }
  .fp-chip :global(.fp-tick) { width: 1rem; height: 1rem; display: none; color: var(--accent); }
  .fp-chip input:checked + label {
    font-weight: 700;
    background: linear-gradient(180deg, rgba(230,184,92,0.24), rgba(230,184,92,0.10)) padding-box, linear-gradient(var(--color-ink-3), var(--color-ink-3)) padding-box, linear-gradient(145deg, var(--color-gold-bright), rgba(230,184,92,0.5)) border-box;
    box-shadow: inset 0 1px 0 rgba(255,236,190,0.25), 0 0 22px -6px rgba(230,184,92,0.55);
  }
  :global([data-theme="day"]) .fp-chip input:checked + label {
    background: linear-gradient(180deg, var(--color-cream-1), var(--color-cream-7)) padding-box, linear-gradient(145deg, var(--color-gold-day), rgba(122,82,0,0.5)) border-box;
    box-shadow: 0 6px 16px -10px rgba(122,82,0,0.45);
  }
  .fp-chip input:checked + label :global(.fp-tick) { display: inline-block; }
  .fp-chip input:focus-visible + label { outline: 2px solid var(--focus); outline-offset: 2px; }
  .fp-answers { margin-top: 0.875rem; }
  .fp-answer {
    display: none; position: relative; margin: 0; padding: 0.875rem 1rem 0.875rem 1.25rem; border-radius: var(--r-well);
    background: var(--glass-1); box-shadow: var(--shine), var(--e1); color: var(--fg);
  }
  .fp-answer::before {
    content: ""; position: absolute; inset: 0.75rem auto 0.75rem 0; width: 3px; border-radius: 0 3px 3px 0; background: var(--accent);
  }
  .fp-choices:has(input[value="0"]:checked) .fp-answer[data-i="0"],
  .fp-choices:has(input[value="1"]:checked) .fp-answer[data-i="1"],
  .fp-choices:has(input[value="2"]:checked) .fp-answer[data-i="2"],
  .fp-choices:has(input[value="3"]:checked) .fp-answer[data-i="3"],
  .fp-choices:has(input[value="4"]:checked) .fp-answer[data-i="4"] { display: block; animation: fp-in 420ms var(--ease-out); }
  @keyframes fp-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @supports not selector(:has(*)) {
    .fp-answer { display: block; margin-top: 0.5rem; }
  }

  .fp-cta { display: flex; flex-direction: column; gap: 0.625rem; padding-top: 0.25rem; }
  .fp-note, .fp-tool { margin: 0; }
  @media (min-width: 40rem) {
    .fp { padding: 1.75rem 1.75rem 1.875rem; }
    .fp-cta :global(.btn-block) { width: auto; align-self: flex-start; }
  }
</style>
