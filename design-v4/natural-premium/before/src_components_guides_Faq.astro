---
/**
 * FAQ (DESIGN_SYSTEM.md §7.8): native <details>, 48px summary rows, visible
 * in the HTML. The FAQPage JSON-LD is built by the layout from the same
 * text; no rich result is expected (SEO_PLAYBOOK.md §6).
 */
import { localeFromPath } from '../../i18n';
import { inlineMarkdown } from '../../lib/guides/guides';

interface Props {
  title: string;
  items: { q: string; a: string }[];
  id?: string;
}

const { title, items, id = 'faq' } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
---

<section class="faq" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="text-h2 font-bold">{title}</h2>
  <div class="faq-list">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary class="faq-q font-bold">{item.q}</summary>
          <div class="faq-a" set:html={`<p>${inlineMarkdown(item.a, locale)}</p>`} />
        </details>
      ))
    }
  </div>
</section>

<style>
  /* Showroom: each question is its own glass row; answers open smoothly where the browser allows. */
  .faq { margin-top: 4rem; }
  .faq h2 { margin: 0 0 1.25rem; }
  .faq-list { display: flex; flex-direction: column; gap: 0.625rem; }
  .faq-item {
    border-radius: var(--r-well); border: 1px solid transparent;
    background: var(--glass-1) padding-box, var(--rim) border-box; box-shadow: var(--shine), 0 10px 24px -18px rgba(0,0,0,0.7);
    transition: box-shadow 320ms var(--ease-out), background 200ms var(--ease);
  }
  :global([data-theme="day"]) .faq-item { box-shadow: var(--shine), 0 8px 20px -16px rgba(23,19,61,0.25); }
  .faq-item:hover, .faq-item[open] { background: var(--glass-1) padding-box, var(--rim-hover) border-box; }
  .faq-item[open] { box-shadow: var(--shine), var(--e1); }
  .faq-q {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.25rem;
    padding: 0.875rem 1rem 0.875rem 1.25rem; cursor: pointer; list-style: none; border-radius: inherit;
  }
  .faq-q::-webkit-details-marker { display: none; }
  /* Plus in a small ring; the vertical bar folds away to a minus. */
  .faq-q::after {
    content: ""; flex: none; width: 2rem; height: 2rem; border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background:
      linear-gradient(var(--accent), var(--accent)) center / 0.75rem 1.5px no-repeat,
      linear-gradient(var(--accent), var(--accent)) center / 1.5px 0.75rem no-repeat;
    transition: transform 360ms var(--ease-out), background-size 360ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }
  .faq-item[open] .faq-q::after {
    transform: rotate(180deg); box-shadow: 0 0 16px -4px rgba(230,184,92,0.55);
    background:
      linear-gradient(var(--accent), var(--accent)) center / 0.75rem 1.5px no-repeat,
      linear-gradient(var(--accent), var(--accent)) center / 1.5px 0 no-repeat;
  }
  .faq-a { padding: 0 1.25rem 1.125rem; color: var(--fg); }
  .faq-a :global(p) { margin: 0; }
  @supports selector(::details-content) {
    .faq-item { interpolate-size: allow-keywords; }
    .faq-item::details-content { block-size: 0; overflow: hidden; opacity: 0; transition: block-size 420ms var(--ease-out), opacity 320ms var(--ease), content-visibility 420ms allow-discrete; }
    .faq-item[open]::details-content { block-size: auto; opacity: 1; }
  }
  @media (min-width: 40rem) { .faq-q { padding-inline: 1.5rem 1.125rem; } .faq-a { padding-inline: 1.5rem 3.5rem; } }
</style>
