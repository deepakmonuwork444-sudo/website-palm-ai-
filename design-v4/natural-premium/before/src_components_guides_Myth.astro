---
/** One myth and its reality, inside <MythReality>. The reality is the slot. */
import { localeFromPath } from '../../i18n';
import { guideStrings } from '../../lib/guides/strings';

interface Props {
  claim: string;
}

const { claim } = Astro.props;
const s = guideStrings(localeFromPath(Astro.url.pathname));
---

<div class="myth glass-card">
  <dt><span class="tag tag-myth text-caption">{s.myth}</span><span class="myth-claim">{claim}</span></dt>
  <dd><span class="tag tag-reality text-caption">{s.reality}</span><div class="myth-reality"><slot /></div></dd>
</div>

<style>
  /* Showroom: one glass card per myth; the myth side is quiet, the reality side is lit. */
  .myth { display: grid; gap: 0; padding: 0; overflow: hidden; }
  .myth dt, .myth dd { margin: 0; display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; padding: 1.125rem 1.25rem; }
  .myth dt { color: var(--fg-muted); }
  .myth dd { background: linear-gradient(160deg, rgba(230,184,92,0.09), transparent 70%); border-top: 1px solid var(--edge); }
  :global([data-theme="day"]) .myth dd { background: linear-gradient(160deg, var(--color-cream-2), transparent 70%); }
  .myth-claim { font-weight: 700; color: var(--fg); }
  .myth-reality :global(p) { margin: 0; }
  .tag { padding: 0.125rem 0.625rem; border-radius: 9999px; font-weight: 700; letter-spacing: 0.02em; border: 1px solid var(--edge); }
  .tag-myth { background: var(--well); color: var(--fg-muted); }
  .tag-reality { background: linear-gradient(180deg, rgba(230,184,92,0.24), rgba(230,184,92,0.10)); color: var(--fg); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  @media (min-width: 64rem) {
    .myth { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
    .myth dt, .myth dd { padding: 1.375rem 1.5rem; }
    .myth dd { border-top: none; border-inline-start: 1px solid var(--edge); }
  }
</style>
