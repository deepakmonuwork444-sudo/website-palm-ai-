---
/**
 * Mobile bottom bar "Scan my palm" (DESIGN_SYSTEM.md §7.10). Hidden at first;
 * src/scripts/site.ts shows it once the hero's gold button has scrolled away
 * and hides it again while any in-page scan button is on screen, so there is
 * never more than one gold action in view. Solid (no blur on mobile), safe-area
 * aware; it steps aside while the footer is on screen (site.ts), so it never covers it.
 * Not rendered at 64rem and up (the header's outline button does the job).
 */
import Icon from '../Icon.astro';

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<div class="sticky-cta" data-sticky-cta inert>
  <a class="btn btn-gold btn-lg btn-block" href={href}>
    <Icon name="camera" class="sticky-icon" />
    <span>{label}</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, rgba(20,17,52,0.94), rgba(7,6,25,0.985));
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, rgba(255,255,255,0.14) 25%, rgba(245,217,139,0.45) 50%, rgba(255,255,255,0.14) 75%, transparent) 1;
    box-shadow: 0 -18px 40px -14px rgba(0, 0, 0, 0.7);
    transform: translateY(110%); visibility: hidden;
    transition: transform var(--dur-sheet) var(--ease-out), visibility 0s linear var(--dur-sheet);
  }
  :global([data-theme="day"]) .sticky-cta {
    background: linear-gradient(180deg, rgba(255,255,255,0.94), rgba(255,255,255,0.99));
    border-image: linear-gradient(90deg, transparent, rgba(23,19,61,0.1) 25%, rgba(122,82,0,0.4) 50%, rgba(23,19,61,0.1) 75%, transparent) 1;
    box-shadow: 0 -14px 34px -14px rgba(23, 19, 61, 0.22);
  }
  .sticky-cta[data-shown] { transform: none; visibility: visible; transition: transform var(--dur-sheet) var(--ease-out); }
  .sticky-cta :global(.sticky-icon) { width: 1.35rem; height: 1.35rem; }
  @media (min-width: 64rem) {
    .sticky-cta { display: none; }
  }
  @media print { .sticky-cta { display: none; } }
</style>
