---
/**
 * Locked part of a reading (DESIGN_SYSTEM.md §7.6): the title, its REAL first
 * sentence fully readable, and a pill. The whole card is the tap target; the
 * link itself is the title only (WEB-DEC-051 R6: a clean anchor text).
 * No blur, no "██", no hidden text: the rest of the part is never in the DOM.
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  firstSentence: string;
  href: string;
  actionLabel: string;
  lockedLabel: string;
}

const { title, firstSentence, href, actionLabel, lockedLabel } = Astro.props;
---

<div class="locked">
  <span class="locked-head">
    <a class="text-h3 font-bold locked-title stretch-link" href={href}>{title}</a>
    <span class="locked-tag text-caption"><Icon name="lock" class="locked-icon" /><span>{lockedLabel}</span></span>
  </span>
  <span class="locked-text">{firstSentence}</span>
  <span class="locked-pill text-small">{actionLabel}</span>
</div>

<style>
  .locked {
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; gap: 0.75rem; padding: 1.375rem 1.375rem 1.25rem; border-radius: var(--r-card, 1.5rem);
    border: 1px solid transparent; color: var(--fg); text-decoration: none;
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01) 50%, rgba(230,184,92,0.1)) padding-box,
      var(--glass-1) padding-box, var(--rim) border-box;
    box-shadow: var(--shine), var(--e1);
    transition: transform 420ms var(--ease-out), box-shadow 420ms var(--ease-out), background 200ms var(--ease);
  }
  /* Frost: fine etched lines rising from the bottom edge, fading out well below the sentence. */
  .locked::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: repeating-linear-gradient(115deg, rgba(255,255,255,0.045) 0 1px, transparent 1px 6px);
    -webkit-mask-image: linear-gradient(0deg, var(--color-black), transparent 55%); mask-image: linear-gradient(0deg, var(--color-black), transparent 55%);
  }
  :global([data-theme="day"]) .locked { background: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0) 50%, rgba(122,82,0,0.06)) padding-box, var(--glass-1) padding-box, var(--rim) border-box; }
  :global([data-theme="day"]) .locked::before { background: repeating-linear-gradient(115deg, rgba(23,19,61,0.035) 0 1px, transparent 1px 6px); }
  .locked:hover, .locked:has(.stretch-link:focus-visible) { background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.01) 50%, rgba(230,184,92,0.14)) padding-box, var(--glass-1) padding-box, var(--rim-hover) border-box; box-shadow: var(--shine), var(--e2); }
  :global([data-theme="day"]) .locked:hover, :global([data-theme="day"]) .locked:has(.stretch-link:focus-visible) { background: linear-gradient(180deg, rgba(255,255,255,0.6), rgba(255,255,255,0) 50%, rgba(122,82,0,0.08)) padding-box, var(--glass-1) padding-box, var(--rim-hover) border-box; }
  .locked:has(.stretch-link:active) { transform: scale(0.985); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .locked:hover { transform: translateY(-4px); } }
  .locked-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; }
  .locked-tag {
    display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.1875rem 0.625rem 0.1875rem 0.5rem; border-radius: 9999px;
    color: var(--fg-muted); white-space: nowrap; border: 1px solid transparent;
    background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)) padding-box, var(--rim) border-box;
  }
  :global([data-theme="day"]) .locked-tag { background: linear-gradient(180deg, var(--color-white), var(--color-day-page)) padding-box, var(--rim) border-box; }
  .locked-tag :global(.locked-icon) { width: 0.9375rem; height: 0.9375rem; color: var(--accent); }
  .locked-pill {
    align-self: flex-start; display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0.25rem 1rem;
    border-radius: 9999px; color: var(--fg); font-weight: 700; border: 1px solid rgba(230,184,92,0.55);
    background: linear-gradient(180deg, rgba(230,184,92,0.16), rgba(230,184,92,0.04));
    box-shadow: inset 0 1px 0 rgba(255,236,190,0.2), 0 0 22px -8px rgba(230,184,92,0.45);
    transition: box-shadow 300ms var(--ease), border-color 300ms var(--ease);
  }
  :global([data-theme="day"]) .locked-pill { border-color: rgba(122,82,0,0.45); background: linear-gradient(180deg, var(--color-cream-1), var(--color-cream-4)); box-shadow: inset 0 1px 0 var(--color-white); }
  .locked:hover .locked-pill { border-color: var(--accent); box-shadow: inset 0 1px 0 rgba(255,236,190,0.28), 0 0 28px -6px rgba(230,184,92,0.6); }
</style>
